---
/**
 * Header 元件
 * 提供包含網頁左上角 Logo、品牌標題與頂部導航之共用導航列。
 */
---

<header class="site-header" transition:persist="site-header">
  <div class="container header-content">
    <!-- 左上角 品牌 Logo 區塊 -->
    <a href="/" class="brand-link" title="回 Gmail Monitor 首頁">
      <div class="logo-wrapper">
        <img src="/logo.svg" alt="Gmail Monitor Logo" class="brand-logo" width="36" height="36" />
        <span class="status-pulse"></span>
      </div>
      <div class="brand-info">
        <span class="brand-name">Gmail<span class="brand-accent">Monitor</span></span>
        <span class="brand-sub">即時監控系統</span>
      </div>
    </a>

    <!-- 搜尋與右側導航 -->
    <nav class="header-nav">
      <div class="header-search-wrap">
        <form id="header-search-form" class="header-search" action="/search" method="get">
          <span class="material-symbols-rounded header-search-icon" aria-hidden="true">search</span>
          <input type="text" name="q" id="header-search-input" placeholder="搜尋寄件者 / 主旨 / 內文摘要" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="header-search-suggestions" aria-expanded="false" />
        </form>
        <div id="header-search-suggestions" class="header-search-suggestions" role="listbox" aria-label="郵件搜尋建議" hidden></div>
      </div>
      <span
        id="connection-status"
        class="connection-badge"
        data-state="connecting"
        role="status"
        aria-live="polite"
        aria-label="即時服務連線中"
        data-tooltip="即時服務連線中"
        tabindex="0"
      >
        <span class="material-symbols-rounded connection-icon" data-connection-icon aria-hidden="true">
          wifi_off
        </span>
        <span class="sr-only" data-connection-label>即時服務連線中</span>
      </span>
      <button id="sync-now" type="button" class="btn btn-outline nav-btn icon-only-btn" title="立即從 Gmail 同步最新郵件" aria-label="立即同步">
        <span class="material-symbols-rounded search-icon" aria-hidden="true">sync</span>
        <span class="sr-only" data-sync-label>立即同步</span>
      </button>
      <button id="generate-summary" type="button" class="btn btn-outline nav-btn icon-only-btn" title="立即產生未讀郵件的 AI 摘要" aria-label="立即產生 AI 摘要">
        <span class="material-symbols-rounded search-icon" data-summary-icon aria-hidden="true">auto_awesome</span>
        <span class="sr-only" data-summary-label>立即產生 AI 摘要</span>
      </button>
      <button id="send-summary-discord" type="button" class="btn btn-outline nav-btn icon-only-btn" title="將最新 AI 摘要發送至 Discord" aria-label="發送最新摘要至 Discord">
        <span class="material-symbols-rounded search-icon" data-discord-icon aria-hidden="true">forward_to_inbox</span>
        <span class="sr-only" data-discord-label>發送最新摘要至 Discord</span>
      </button>
      <button id="theme-toggle" type="button" class="btn btn-outline nav-btn theme-toggle-btn" title="切換主題" aria-label="切換主題">
        <span id="theme-icon-light" class="material-symbols-rounded theme-icon" aria-hidden="true">light_mode</span>
        <span id="theme-icon-dark" class="material-symbols-rounded theme-icon" aria-hidden="true" style="display:none;">dark_mode</span>
      </button>
    </nav>
  </div>
  <div id="header-action-toast" class="header-toast" role="status" aria-live="polite" hidden></div>
</header>

<script>
  import { navigate } from "astro:transitions/client";
  import { startRealtimeConnection } from "../lib/realtimeClient";

  const INITIAL_SYNC_KEY = "gmail-monitor:initial-sync-completed";

  startRealtimeConnection();

  const themeBtn = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const lightIcon = document.querySelector<HTMLElement>("#theme-icon-light");
  const darkIcon = document.querySelector<HTMLElement>("#theme-icon-dark");

  function syncThemeIcons() {
    const isDark = document.documentElement.dataset.theme === "dark";
    if (lightIcon) lightIcon.style.display = isDark ? "none" : "block";
    if (darkIcon) darkIcon.style.display = isDark ? "block" : "none";
  }

  syncThemeIcons();
  themeBtn?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    syncThemeIcons();
  });

  const searchForm = document.querySelector<HTMLFormElement>("#header-search-form");
  const searchInput = document.querySelector<HTMLInputElement>("#header-search-input");
  const suggestions = document.querySelector<HTMLElement>("#header-search-suggestions");
  const SEARCH_CACHE_TTL = 5 * 60 * 1000;
  const SEARCH_CACHE_PREFIX = "gmail-monitor:search-suggestions:";
  type SuggestedEmail = { id: string; sender: string; subject: string; snippet: string };
  type CachedSuggestions = { expiresAt: number; emails: SuggestedEmail[] };
  const searchCache = new Map<string, CachedSuggestions>();
  let searchRequestId = 0;
  let searchTimer: number | undefined;
  let activeSearchController: AbortController | undefined;

  function closeSuggestions() {
    if (suggestions) suggestions.hidden = true;
    searchInput?.setAttribute("aria-expanded", "false");
  }

  function renderSuggestions(emails: SuggestedEmail[], query: string) {
    if (!suggestions) return;
    if (emails.length === 0) {
      suggestions.innerHTML = `<p class="header-search-empty">找不到符合「${escapeHtml(query)}」的郵件</p>`;
    } else {
      suggestions.innerHTML = emails.map((email) => `
        <a class="header-search-suggestion" role="option" href="/emails/${encodeURIComponent(email.id)}">
          <span class="header-search-suggestion-sender">${escapeHtml(email.sender)}</span>
          <span class="header-search-suggestion-subject">${escapeHtml(email.subject || "（無主旨）")}</span>
          <span class="header-search-suggestion-snippet">${escapeHtml(email.snippet || "")}</span>
        </a>
      `).join("");
    }
    suggestions.hidden = false;
    searchInput?.setAttribute("aria-expanded", "true");
  }

  function escapeHtml(value: string) {
    const element = document.createElement("span");
    element.textContent = value;
    return element.innerHTML;
  }

  function getCachedSuggestions(query: string): SuggestedEmail[] | undefined {
    const cached = searchCache.get(query);
    if (cached && cached.expiresAt > Date.now()) return cached.emails;
    searchCache.delete(query);

    try {
      const stored = sessionStorage.getItem(`${SEARCH_CACHE_PREFIX}${query}`);
      if (!stored) return undefined;
      const parsed = JSON.parse(stored) as CachedSuggestions;
      if (parsed.expiresAt <= Date.now() || !Array.isArray(parsed.emails)) {
        sessionStorage.removeItem(`${SEARCH_CACHE_PREFIX}${query}`);
        return undefined;
      }
      searchCache.set(query, parsed);
      return parsed.emails;
    } catch {
      return undefined;
    }
  }

  function cacheSuggestions(query: string, emails: SuggestedEmail[]) {
    const cached = { emails, expiresAt: Date.now() + SEARCH_CACHE_TTL };
    searchCache.set(query, cached);
    try {
      sessionStorage.setItem(`${SEARCH_CACHE_PREFIX}${query}`, JSON.stringify(cached));
    } catch {
      // 瀏覽器禁止儲存空間時，仍保留本頁面的記憶體快取。
    }
  }

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim();
    window.clearTimeout(searchTimer);
    activeSearchController?.abort();
    const requestId = ++searchRequestId;
    if (query.length < 2) {
      closeSuggestions();
      return;
    }
    const cached = getCachedSuggestions(query);
    if (cached) {
      renderSuggestions(cached, query);
      return;
    }
    searchTimer = window.setTimeout(async () => {
      const controller = new AbortController();
      activeSearchController = controller;
      try {
        const response = await fetch(`/api/emails/suggestions?q=${encodeURIComponent(query)}`, {
          signal: controller.signal,
        });
        const result = await response.json();
        if (requestId !== searchRequestId || !response.ok) return;
        const emails = result.emails ?? [];
        cacheSuggestions(query, emails);
        renderSuggestions(emails, query);
      } catch {
        if (requestId === searchRequestId) closeSuggestions();
      } finally {
        if (activeSearchController === controller) activeSearchController = undefined;
      }
    }, 350);
  });
  searchInput?.addEventListener("focus", () => {
    if (searchInput.value.trim() && suggestions?.childElementCount) {
      suggestions.hidden = false;
      searchInput.setAttribute("aria-expanded", "true");
    }
  });
  searchForm?.addEventListener("submit", closeSuggestions);
  document.addEventListener("click", (event) => {
    if (!suggestions?.contains(event.target as Node) && event.target !== searchInput) closeSuggestions();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeSuggestions();
      searchInput?.blur();
    }
  });
  document.addEventListener("astro:after-swap", () => {
    const stored = localStorage.getItem("theme");
    document.documentElement.dataset.theme = stored === "light" ? "light" : "dark";
    syncThemeIcons();
  });

  async function syncEmails(automatic = false) {
    const syncBtn = document.querySelector<HTMLButtonElement>("#sync-now");
    const syncLabel = document.querySelector<HTMLElement>("[data-sync-label]");
    if (!syncBtn || !syncLabel || syncBtn.disabled) return;

    const defaultLabel = "立即同步";
    syncBtn.disabled = true;
    syncLabel.textContent = automatic ? "首次同步中..." : "同步中...";

    try {
      const res = await fetch("/api/gmail/sync", { method: "POST" });
      const result = await res.json();
      if (!res.ok || result.error) throw new Error(result.error || "同步失敗");

      sessionStorage.setItem(INITIAL_SYNC_KEY, "1");
      syncLabel.textContent = `已同步 ${result.imported ?? 0} 封`;

      if ((result.imported ?? 0) > 0) {
        window.setTimeout(() => {
          navigate(window.location.pathname + window.location.search, { history: "replace" });
        }, 500);
      }
    } catch {
      if (automatic) sessionStorage.removeItem(INITIAL_SYNC_KEY);
      syncLabel.textContent = "同步失敗";
    } finally {
      window.setTimeout(() => {
        syncBtn.disabled = false;
        syncLabel.textContent = defaultLabel;
      }, 2500);
    }
  }

  document.querySelector<HTMLButtonElement>("#sync-now")?.addEventListener("click", () => {
    void syncEmails(false);
  });

  const toast = document.querySelector<HTMLElement>("#header-action-toast");
  let toastTimer: number | undefined;

  function showToast(message: string, tone: "info" | "success" | "error" = "info") {
    if (!toast) return;
    toast.textContent = message;
    toast.dataset.tone = tone;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { toast.hidden = true; }, 5000);
  }

  async function postJson(url: string, body: unknown) {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      // detail 只寫入 console，避免把底層 API 訊息塞進 toast
      if (data.detail) console.error(`${url} 失敗：`, data.detail);
      throw new Error(data.error || "請求失敗");
    }
    return data;
  }

  /** icon-only 按鈕在執行期間換成沙漏，結束後復原，避免使用者重複點擊 */
  async function runHeaderAction(
    btn: HTMLButtonElement,
    icon: HTMLElement | null,
    task: () => Promise<void>,
  ) {
    if (btn.disabled) return;
    const defaultIcon = icon?.textContent ?? "";
    btn.disabled = true;
    if (icon) icon.textContent = "hourglass_top";
    try {
      await task();
    } catch (err) {
      showToast(err instanceof Error ? err.message : "操作失敗，請稍後再試。", "error");
    } finally {
      if (icon) icon.textContent = defaultIcon;
      btn.disabled = false;
    }
  }

  const summaryBtn = document.querySelector<HTMLButtonElement>("#generate-summary");
  summaryBtn?.addEventListener("click", () => {
    const icon = summaryBtn.querySelector<HTMLElement>("[data-summary-icon]");
    void runHeaderAction(summaryBtn, icon, async () => {
      showToast("AI 摘要產生中…");
      const result = await postJson("/api/summaries/generate", { sendDiscord: false });

      if (result.status === "skipped") {
        showToast(
          result.reason === "no unread emails"
            ? "目前沒有未讀郵件，無需產生摘要。"
            : "已跳過：沒有新的未讀郵件。",
        );
        return;
      }

      showToast(`已產生 ${result.emailCount} 封未讀郵件的 AI 摘要。`, "success");
      if (window.location.pathname === "/summaries" || window.location.pathname === "/") {
        window.setTimeout(() => {
          navigate(window.location.pathname + window.location.search, { history: "replace" });
        }, 800);
      }
    });
  });

  const discordBtn = document.querySelector<HTMLButtonElement>("#send-summary-discord");
  discordBtn?.addEventListener("click", () => {
    const icon = discordBtn.querySelector<HTMLElement>("[data-discord-icon]");
    void runHeaderAction(discordBtn, icon, async () => {
      showToast("發送最新摘要至 Discord…");
      await postJson("/api/summaries/send-discord", {});
      showToast("已將最新 AI 摘要發送至 Discord。", "success");
    });
  });

  if (!sessionStorage.getItem(INITIAL_SYNC_KEY)) {
    sessionStorage.setItem(INITIAL_SYNC_KEY, "pending");
    void syncEmails(true);
  }

  document.addEventListener("astro:page-load", () => {
    syncThemeIcons();
  });
</script>

<style>
  .site-header {
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
    position: sticky;
    top: 0;
    z-index: 2000;
    isolation: isolate;
    padding: var(--space-3) 0;
  }

  .header-content {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .brand-link:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .logo-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-logo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.3);
    object-fit: contain;
    transition: box-shadow var(--transition-base);
  }

  .brand-link:hover .brand-logo {
    box-shadow: 0 0 18px rgba(99, 102, 241, 0.6);
  }

  .status-pulse {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 8px;
    height: 8px;
    background-color: var(--color-success);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-success);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .brand-accent {
    color: var(--color-primary-hover);
    margin-left: 2px;
  }

  .brand-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-regular);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex: 1;
    min-width: 0;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
    border-radius: var(--radius-full);
  }

  .search-icon {
    font-size: 16px;
    opacity: 0.8;
  }

  .header-search-wrap {
    position: relative;
    flex: 1;
    min-width: 180px;
  }

  .header-search {
    display: flex;
    align-items: center;
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .header-search:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
  }

  .header-search-icon {
    margin-left: var(--space-4);
    color: var(--color-text-tertiary);
    font-size: 18px;
  }

  .header-search input {
    min-width: 0;
    flex: 1;
    padding: var(--space-2) var(--space-4);
    border: none;
    background: transparent;
    color: var(--color-text);
    border-radius: var(--radius-full);
  }

  .header-search input:focus {
    outline: none;
  }

  .header-search-suggestions {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    z-index: 10;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg, 0 12px 28px rgba(0, 0, 0, 0.28));
  }

  .header-search-suggestion {
    display: grid;
    grid-template-columns: minmax(100px, 0.3fr) minmax(0, 0.7fr);
    gap: 2px var(--space-3);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text);
    text-decoration: none;
  }

  .header-search-suggestion + .header-search-suggestion { border-top: 1px solid var(--color-border-subtle); }
  .header-search-suggestion:hover, .header-search-suggestion:focus { background: var(--color-surface-hover); text-decoration: none; }
  .header-search-suggestion-sender { overflow: hidden; color: var(--color-text-secondary); font-size: var(--font-size-sm); text-overflow: ellipsis; white-space: nowrap; }
  .header-search-suggestion-subject { overflow: hidden; font-weight: var(--font-weight-medium); text-overflow: ellipsis; white-space: nowrap; }
  .header-search-suggestion-snippet { grid-column: 1 / -1; overflow: hidden; color: var(--color-text-tertiary); font-size: var(--font-size-xs); text-overflow: ellipsis; white-space: nowrap; }
  .header-search-empty { margin: 0; padding: var(--space-4); color: var(--color-text-tertiary); font-size: var(--font-size-sm); }

  @media (max-width: 760px) {
    .brand-info { display: none; }
    .header-content { gap: var(--space-3); }
    .header-nav { gap: var(--space-2); }
    .header-search-wrap { min-width: 0; }
    .connection-badge, #generate-summary, #send-summary-discord { display: none; }
  }

  .theme-toggle-btn {
    padding: var(--space-2);
  }

  .icon-only-btn {
    padding: var(--space-2);
  }

  .theme-icon {
    display: block;
  }

  /* 導航列動作的結果提示，掛在 header 下緣避免推動版面 */
  .header-toast {
    position: absolute;
    right: var(--space-6);
    bottom: calc(-1 * var(--space-2));
    transform: translateY(100%);
    max-width: min(420px, calc(100vw - var(--space-8)));
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md, 0 4px 16px rgba(0, 0, 0, 0.25));
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .header-toast[hidden] {
    display: none;
  }

  .header-toast[data-tone="success"] {
    color: var(--color-success);
    border-color: var(--color-success);
  }

  .header-toast[data-tone="error"] {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .connection-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    padding: 0;
    background: rgba(239, 68, 68, 0.15);
    color: var(--color-error);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: var(--radius-full);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .connection-badge::after {
    content: attr(data-tooltip);
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 50%;
    z-index: 1;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-tight);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -4px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .connection-badge:hover::after,
  .connection-badge:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .connection-badge[data-state="connected"] {
    background: rgba(34, 197, 94, 0.15);
    color: var(--color-success);
    border-color: rgba(34, 197, 94, 0.35);
  }

  .connection-icon {
    font-size: 18px;
  }

  .connection-badge[data-state="connecting"] .connection-icon {
    animation: connection-pulse 1.2s ease-in-out infinite;
  }

  @keyframes connection-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }
</style>
