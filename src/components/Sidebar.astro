---
import { categoryBadge } from "../lib/categoryBadge";
import { categories } from "../lib/classify";

export interface Props {
  activeView?: "home" | "all" | "unread" | "important" | "search" | "summaries" | "senders" | "first-senders" | "analytics" | "cleanup" | "reviews" | "inbound";
  activeCategory?: string | null;
}

const { activeView = null, activeCategory = null } = Astro.props;
---

<aside id="app-sidebar" class="app-sidebar" aria-label="側邊導覽">
  <div class="sidebar-header">
    <button
      id="sidebar-toggle"
      class="sidebar-toggle"
      type="button"
      aria-controls="sidebar-navigation"
      aria-expanded="true"
      aria-label="折疊側邊欄"
      title="折疊側邊欄"
    >
      <span class="material-symbols-rounded sidebar-toggle-icon" aria-hidden="true">
        left_panel_close
      </span>
    </button>
    <strong class="mobile-sidebar-title">功能選單</strong>
    <button
      id="mobile-sidebar-close"
      class="mobile-sidebar-close"
      type="button"
      aria-label="關閉側邊欄"
    >
      <span class="material-symbols-rounded" aria-hidden="true">close</span>
    </button>
  </div>

  <nav id="sidebar-navigation" class="sidebar-nav" aria-label="主要導覽">
    <div class="sidebar-section">
      <a href="/" class:list={["sidebar-link", { active: activeView === "home" }]} aria-label="儀表板" title="儀表板">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">dashboard</span>
        <span class="sidebar-label">儀表板</span>
      </a>
      <a href="/emails" class:list={["sidebar-link", { active: activeView === "all" }]} aria-label="全部郵件" title="全部郵件">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">mail</span>
        <span class="sidebar-label">全部郵件</span>
      </a>
      <a href="/unread" class:list={["sidebar-link", { active: activeView === "unread" }]} aria-label="未讀郵件" title="未讀郵件">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">mark_email_unread</span>
        <span class="sidebar-label">未讀郵件</span>
      </a>
      <a href="/emails?important=1" class:list={["sidebar-link", { active: activeView === "important" }]} aria-label="重要郵件" title="重要郵件">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">star</span>
        <span class="sidebar-label">重要郵件</span>
      </a>
      <a href="/senders" class:list={["sidebar-link", { active: activeView === "senders" }]} aria-label="常見寄件者" title="常見寄件者">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">group</span>
        <span class="sidebar-label">常見寄件者</span>
      </a>
      <a href="/analytics" class:list={["sidebar-link", { active: activeView === "analytics" }]} aria-label="郵件分析" title="郵件分析">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">analytics</span>
        <span class="sidebar-label">郵件分析</span>
      </a>
      <a href="/first-senders" class:list={["sidebar-link", { active: activeView === "first-senders" }]} aria-label="首次安全紀錄" title="首次安全紀錄">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">verified_user</span>
        <span class="sidebar-label">首次安全紀錄</span>
      </a>
      <a href="/inbound" class:list={["sidebar-link", { active: activeView === "inbound" }]} aria-label="站點收件匣" title="站點收件匣">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">forward_to_inbox</span>
        <span class="sidebar-label">站點收件匣</span>
      </a>
    </div>

    <div class="sidebar-section">
      <span class="sidebar-heading">分類</span>
      {categories.map((category) => {
        const badge = categoryBadge(category);
        return (
          <a
            href={`/emails?category=${encodeURIComponent(category)}`}
            class:list={["sidebar-link", { active: activeCategory === category }]}
            aria-label={badge?.label ?? category}
            title={badge?.label ?? category}
          >
            {badge && <span class="sidebar-dot" style={`background:${badge.bg};`}></span>}
            <span class="sidebar-label">{badge?.label ?? category}</span>
          </a>
        );
      })}
    </div>

    <div class="sidebar-section">
      <a href="/summaries" class:list={["sidebar-link", { active: activeView === "summaries" }]} aria-label="摘要記錄" title="摘要記錄">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">menu_book</span>
        <span class="sidebar-label">摘要記錄</span>
      </a>
      <a href="/cleanup" class:list={["sidebar-link", { active: activeView === "cleanup" }]} aria-label="關鍵字清理" title="關鍵字清理">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">delete_sweep</span>
        <span class="sidebar-label">關鍵字清理</span>
      </a>
      <a href="/reviews" class:list={["sidebar-link", { active: activeView === "reviews" }]} aria-label="待審核" title="待審核">
        <span class="material-symbols-rounded sidebar-icon" aria-hidden="true">fact_check</span>
        <span class="sidebar-label">待審核</span>
      </a>
    </div>
  </nav>
</aside>
<button id="mobile-sidebar-backdrop" class="mobile-sidebar-backdrop" type="button" aria-label="關閉側邊欄"></button>

<script>
  const closeMobileSidebar = (restoreFocus = false) => {
    document.documentElement.classList.remove("mobile-sidebar-open");
    const trigger = document.querySelector<HTMLButtonElement>("#mobile-sidebar-toggle");
    trigger?.setAttribute("aria-expanded", "false");
    if (restoreFocus) trigger?.focus();
  };

  const initializeSidebarToggle = () => {
    const toggle = document.querySelector<HTMLButtonElement>("#sidebar-toggle");
    if (!toggle || toggle.dataset.initialized === "true") return;

    const icon = toggle.querySelector<HTMLElement>(".sidebar-toggle-icon");

    const updateToggle = (collapsed: boolean) => {
      const action = collapsed ? "展開側邊欄" : "折疊側邊欄";
      document.documentElement.dataset.sidebarCollapsed = String(collapsed);
      toggle.setAttribute("aria-expanded", String(!collapsed));
      toggle.setAttribute("aria-label", action);
      toggle.title = action;
      if (icon) icon.textContent = collapsed ? "left_panel_open" : "left_panel_close";
    };

    updateToggle(document.documentElement.dataset.sidebarCollapsed === "true");
    toggle.addEventListener("click", () => {
      const collapsed = document.documentElement.dataset.sidebarCollapsed !== "true";
      updateToggle(collapsed);
      localStorage.setItem("sidebar-collapsed", String(collapsed));
    });
    toggle.dataset.initialized = "true";

    const mobileClose = document.querySelector<HTMLButtonElement>("#mobile-sidebar-close");
    const backdrop = document.querySelector<HTMLButtonElement>("#mobile-sidebar-backdrop");
    if (mobileClose?.dataset.initialized !== "true") {
      mobileClose?.addEventListener("click", () => closeMobileSidebar(true));
      if (mobileClose) mobileClose.dataset.initialized = "true";
    }
    if (backdrop?.dataset.initialized !== "true") {
      backdrop?.addEventListener("click", () => closeMobileSidebar(true));
      if (backdrop) backdrop.dataset.initialized = "true";
    }

    document.querySelectorAll<HTMLAnchorElement>("#sidebar-navigation a").forEach((link) => {
      if (link.dataset.mobileInitialized === "true") return;
      link.addEventListener("click", () => closeMobileSidebar());
      link.dataset.mobileInitialized = "true";
    });
  };

  document.addEventListener("astro:page-load", initializeSidebarToggle);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && document.documentElement.classList.contains("mobile-sidebar-open")) {
      closeMobileSidebar(true);
    }
  });
  initializeSidebarToggle();
</script>

<style>
  .sidebar-header {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-4) var(--space-4) 0;
  }

  .sidebar-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .sidebar-toggle:hover {
    border-color: var(--color-border);
    background-color: var(--color-bg-tertiary);
    color: var(--color-text);
  }

  .sidebar-toggle-icon {
    font-size: 20px;
  }

  .mobile-sidebar-title,
  .mobile-sidebar-close,
  .mobile-sidebar-backdrop {
    display: none;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-4) var(--space-6);
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar-heading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-2) var(--space-3);
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .sidebar-link:hover {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text);
  }

  .sidebar-link.active {
    background-color: var(--color-primary-muted);
    color: var(--color-primary-hover);
    font-weight: var(--font-weight-medium);
  }

  .sidebar-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.8;
  }

  .sidebar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (min-width: 769px) {
    :global(html[data-sidebar-collapsed="true"]) .sidebar-header {
      justify-content: center;
      padding-inline: var(--space-3);
    }

    :global(html[data-sidebar-collapsed="true"]) .sidebar-nav {
      padding-inline: var(--space-3);
    }

    :global(html[data-sidebar-collapsed="true"]) .sidebar-link {
      justify-content: center;
      gap: 0;
      padding-inline: var(--space-2);
    }

    :global(html[data-sidebar-collapsed="true"]) .sidebar-label,
    :global(html[data-sidebar-collapsed="true"]) .sidebar-heading {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 64px;
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .sidebar-toggle {
      display: none;
    }

    .mobile-sidebar-title {
      display: block;
      font-size: var(--font-size-base);
    }

    .mobile-sidebar-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: var(--radius-full);
      background: var(--color-bg-tertiary);
      color: var(--color-text);
    }

    .sidebar-nav {
      flex-direction: column;
      overflow-x: hidden;
      overflow-y: auto;
      gap: var(--space-6);
      height: calc(100dvh - 64px);
      padding: var(--space-4) var(--space-4) calc(var(--space-6) + env(safe-area-inset-bottom));
      overscroll-behavior: contain;
    }

    .sidebar-section {
      flex-direction: column;
      flex-shrink: 1;
    }

    .sidebar-heading {
      display: block;
    }

    .sidebar-link {
      flex-direction: row;
      justify-content: flex-start;
      gap: var(--space-3);
      min-width: 0;
      min-height: 46px;
      padding: var(--space-2) var(--space-3);
      font-size: var(--font-size-sm);
      white-space: nowrap;
    }

    .sidebar-icon {
      width: 20px;
      height: 20px;
      font-size: 20px;
    }

    .sidebar-dot {
      width: 10px;
      height: 10px;
    }

    .mobile-sidebar-backdrop {
      position: fixed;
      z-index: 2490;
      inset: 0;
      border: 0;
      background: rgba(0, 0, 0, 0.56);
      cursor: default;
    }

    :global(html.mobile-sidebar-open) .mobile-sidebar-backdrop {
      display: block;
    }
  }
</style>
