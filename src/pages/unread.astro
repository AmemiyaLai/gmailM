---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import EmailCard from "../components/EmailCard.astro";
import FilterBar from "../components/FilterBar.astro";
import { listEmails } from "../lib/emailQueries";
import { categoryBadge } from "../lib/categoryBadge";
import { parseEmailFilterParams, buildFilterHref } from "../lib/emailFilters";
import { extractSenderName } from "../lib/senderUtils";

const PAGE_SIZE = 50;

const filters = parseEmailFilterParams(Astro.url);
const offset = (filters.page - 1) * PAGE_SIZE;

const { emails, hasMore } = await listEmails({
  category: filters.category,
  sender: filters.sender,
  recipient: filters.recipient,
  from: filters.from,
  to: filters.to,
  onlyUnread: true,
  onlyImportant: filters.important,
  limit: PAGE_SIZE,
  offset,
});

const badge = filters.category ? categoryBadge(filters.category) : null;
const heading = filters.category ? `未讀郵件 · ${badge?.label ?? filters.category}` : "未讀郵件";

interface SenderGroup {
  sender: string;
  emails: typeof emails;
}

const groups: SenderGroup[] = [];
const groupMap = new Map<string, typeof emails>();
for (const email of emails) {
  const existing = groupMap.get(email.sender);
  if (existing) {
    existing.push(email);
  } else {
    const arr = [email];
    groupMap.set(email.sender, arr);
    groups.push({ sender: email.sender, emails: arr });
  }
}
---

<SidebarLayout title={`${heading} — Gmail 即時監控面板`} activeView="unread" activeCategory={filters.category ?? null}>
  <h1 style="font-size:var(--font-size-2xl); margin-bottom:var(--space-6);">{heading}</h1>

  <FilterBar
    action="/unread"
    category={filters.category}
    sender={filters.sender}
    recipient={filters.recipient}
    from={filters.from}
    to={filters.to}
    important={filters.important}
    showUnreadToggle={false}
  />

  <div id="email-list" style="border:1px solid var(--color-border); border-radius:var(--radius-md); overflow:hidden;">
    {groups.map((group, i) => (
      <details class="sender-group" open={i === 0} data-sender={group.sender}>
        <summary class="sender-group-header">
          <span class="sender-group-toggle"></span>
          <input type="checkbox" class="group-select-all" aria-label={`全選 ${group.sender}`} />
          <span class="sender-group-name">{extractSenderName(group.sender)}</span>
          <span class="badge" style="background:var(--color-bg-tertiary); color:var(--color-text-secondary);">{group.emails.length} 封</span>
        </summary>
        <div class="sender-group-body">
          {group.emails.map((email) => (
            <EmailCard
              id={email.id}
              sender={email.sender}
              subject={email.subject}
              snippet={email.snippet}
              receivedAt={email.received_at}
              isRead={email.is_read}
              category={email.category}
              isImportant={email.is_important}
              isStarred={email.is_starred}
            />
          ))}
        </div>
      </details>
    ))}

    {emails.length === 0 && (
      <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
        目前沒有未讀郵件。
      </div>
    )}
  </div>

  <div style="display:flex; justify-content:space-between; margin-top:var(--space-8);">
    {filters.page > 1 ? (
      <a href={buildFilterHref("/unread", { ...filters, page: filters.page - 1 })} class="btn btn-outline">上一頁</a>
    ) : <span />}
    {hasMore && <a href={buildFilterHref("/unread", { ...filters, page: filters.page + 1 })} class="btn btn-outline">下一頁</a>}
  </div>

  <style>
    .sender-group { border-bottom: 1px solid var(--color-border-subtle); }
    .sender-group:last-child { border-bottom: none; }
    .sender-group-header {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      background: var(--color-bg-secondary);
      cursor: pointer;
      user-select: none;
      list-style: none;
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }
    .sender-group-header::-webkit-details-marker { display: none; }
    .sender-group-header::marker { content: ""; }
    .sender-group-toggle {
      width: 0; height: 0;
      border-left: 4px solid var(--color-text-tertiary);
      border-top: 4px solid transparent;
      border-bottom: 4px solid transparent;
      transition: transform var(--transition-fast);
      flex-shrink: 0;
    }
    .sender-group[open] > .sender-group-header .sender-group-toggle {
      transform: rotate(90deg);
    }
    .sender-group-name {
      font-weight: var(--font-weight-medium);
      color: var(--color-text);
    }
    .group-select-all {
      flex-shrink: 0;
      accent-color: var(--color-primary);
    }
  </style>

  <script>
    import { initEmailList } from "../lib/emailListClient";
    initEmailList(document.getElementById("email-list")!);
  </script>
</SidebarLayout>
