---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import EmailCard from "../components/EmailCard.astro";
import FilterBar from "../components/FilterBar.astro";
import EmailListShell from "../components/EmailListShell.astro";
import {
  buildEmailSearchFallbackFilters,
  buildEmailSearchPatterns,
  isMissingEmailSearchTextColumn,
} from "../lib/emailSearch";
import { getSupabase } from "../lib/supabase";
import { endOfTaipeiDate, parseEmailFilterParams, startOfTaipeiDate } from "../lib/emailFilters";
import { buildSenderJumpItems } from "../lib/emailDisplayGroups";

interface EmailResult {
  id: string;
  sender: string;
  subject: string;
  snippet: string;
  received_at: string;
  is_read: boolean;
  category: string | null;
  is_important?: boolean;
  labels: string[] | null;
}

const filters = parseEmailFilterParams(Astro.url);

const supabase = getSupabase();
const buildQuery = (useSearchText: boolean) => {
  let query = supabase
    .from("emails" as never)
    .select("id, sender, subject, snippet, received_at, is_read, category, is_important, labels")
    .order("received_at", { ascending: false })
    .limit(50);

  if (filters.q) {
    if (useSearchText) {
      for (const pattern of buildEmailSearchPatterns(filters.q)) {
        query = query.ilike("search_text", pattern);
      }
    } else {
      for (const filter of buildEmailSearchFallbackFilters(filters.q)) {
        query = query.or(filter);
      }
    }
  }
  if (filters.category) {
    query = query.eq("category", filters.category);
  }
  if (filters.from) {
    query = query.gte("received_at", startOfTaipeiDate(filters.from));
  }
  if (filters.to) {
    query = query.lte("received_at", endOfTaipeiDate(filters.to));
  }
  if (filters.sender) {
    query = query.ilike("sender", `%${filters.sender}%`);
  }
  if (filters.recipient) {
    query = query.ilike("recipient", `%${filters.recipient}%`);
  }
  if (filters.unread) {
    query = query.eq("is_read", false);
  }

  return query;
};

let result = await buildQuery(true);
if (isMissingEmailSearchTextColumn(result.error)) {
  result = await buildQuery(false);
}
const { data, error } = result;
const emails = (data ?? []) as EmailResult[];
const senderJumpItems = buildSenderJumpItems(emails);
const senderJumpIdBySender = new Map(senderJumpItems.map((item) => [item.sender, item.id]));
const senderJumpIdByEmailId = new Map<string, string>();
const anchoredJumpIds = new Set<string>();
for (const email of emails) {
  const jumpId = senderJumpIdBySender.get(email.sender);
  if (jumpId && !anchoredJumpIds.has(jumpId)) {
    senderJumpIdByEmailId.set(email.id, jumpId);
    anchoredJumpIds.add(jumpId);
  }
}
---

<SidebarLayout title="搜尋 — Gmail 即時監控面板" activeView="search">
  <EmailListShell items={senderJumpItems}>
    <h1 style="font-size:var(--font-size-2xl); margin-bottom:var(--space-6);">搜尋郵件</h1>

    <FilterBar
      action="/search"
      q={filters.q}
      category={filters.category}
      sender={filters.sender}
      recipient={filters.recipient}
      from={filters.from}
      to={filters.to}
      unread={filters.unread}
    />

    {error && (
      <div style="color:var(--color-error); margin-bottom:var(--space-4);">
        查詢失敗：{error.message}
      </div>
    )}

    <div id="email-list" class="email-list-scroll" data-unread-only={filters.unread ? "true" : "false"} style="border:1px solid var(--color-border); border-radius:var(--radius-md);">
      {emails.map((email) => (
        <div
          id={senderJumpIdByEmailId.get(email.id)}
          class:list={{ "sender-jump-target": senderJumpIdByEmailId.has(email.id) }}
        >
          <EmailCard
          id={email.id}
          sender={email.sender}
          subject={email.subject}
          snippet={email.snippet}
          receivedAt={email.received_at}
          isRead={email.is_read}
          category={email.category}
          isImportant={email.is_important}
          isStarred={(email.labels ?? []).includes("STARRED")}
          />
        </div>
      ))}

      {emails.length === 0 && !error && (
        <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
          沒有符合條件的郵件。
        </div>
      )}
    </div>
  </EmailListShell>

    <script>
      import { initEmailList } from "../lib/emailListClient";
      document.addEventListener("astro:page-load", () => {
        if (window.location.pathname !== "/search") return;
        const list = document.getElementById("email-list");
        if (list) initEmailList(list);
      });
    </script>
</SidebarLayout>
