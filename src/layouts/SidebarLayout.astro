---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";

export interface Props {
  title: string;
  description?: string;
  activeView?: "home" | "all" | "unread" | "important" | "search" | "summaries" | "senders" | "first-senders" | "analytics" | "cleanup";
  activeCategory?: string | null;
}

const {
  title,
  description,
  activeView,
  activeCategory,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="app-shell">
    <Sidebar activeView={activeView} activeCategory={activeCategory} />
    <div class="app-main">
      <Header />
      <main class="container" style="padding: var(--space-6) 0 var(--space-12) 0;">
        <h1 class="sr-only">{title}</h1>
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
