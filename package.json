{
  "name": "gmail-monitor-panel",
  "type": "module",
  "version": "0.1.0",
  "description": "Gmail 即時監控面板 — Astro SSR + Supabase + Pusher",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:routes": "node scripts/check-routes.mjs",
    "check:all": "npm run type-check && npm run test:unit && npm run check:routes && npm run build",
    "astro": "astro",
    "type-check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.3",
    "@google/genai": "^2.13.0",
    "@supabase/supabase-js": "^2.110.8",
    "astro": "^7.1.1",
    "chart.js": "^4.5.1",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "supabase": "^2.109.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
