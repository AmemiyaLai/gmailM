---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="找不到頁面" description="找不到要求的頁面。" noIndex>
  <main class="container" style="padding: var(--space-16) 0; text-align: center;">
    <h1>404</h1>
    <p style="color: var(--color-text-secondary); margin: var(--space-4) 0;">
      這個網址不存在，請返回首頁。
    </p>
    <a href="/" class="btn btn-primary">返回首頁</a>
  </main>
</BaseLayout>
