---
import { KnowledgeLayout } from "@amemiyalai/wiki-center/astro";
import { navigation, site } from "../../site.config";
---

<KnowledgeLayout site={site} title="知識庫" description="瀏覽所有知識分類。" showSidebar={false}>
  <h1>知識庫</h1>
  <p>依分類瀏覽網站內容，文章與導航皆由本地設定檔控制。</p>
  <div class="topic-grid">
    {navigation.map((module) => <article><h2>{module.icon} {module.title}</h2><p>{module.description}</p>{module.articles.map((article) => <p><a href={article.href}>{article.title}</a></p>)}</article>)}
  </div>
</KnowledgeLayout>

<style>.topic-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}.topic-grid article{padding:18px;border:1px solid color-mix(in srgb,var(--knowledge-text) 10%,transparent);border-radius:14px;background:var(--knowledge-surface)}</style>
