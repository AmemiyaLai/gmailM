---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import { getSupabase } from "../lib/supabase";

interface SummaryRow {
  id: string;
  summary_text: string;
  email_count: number;
  period_start: string;
  period_end: string;
  created_at: string;
}

const supabase = getSupabase();
const { data, error } = await supabase
  .from("email_summaries" as never)
  .select("id, summary_text, email_count, period_start, period_end, created_at")
  .order("created_at", { ascending: false })
  .limit(50);
const summaries = (data ?? []) as SummaryRow[];
---

<SidebarLayout title="摘要記錄 — Gmail 即時監控面板" activeView="summaries">
    <h1 style="font-size:var(--font-size-2xl); margin-bottom:var(--space-4);">每小時未讀郵件摘要</h1>

    <p style="font-size:var(--font-size-sm); color:var(--color-text-tertiary); margin-bottom:var(--space-2);">
      需要立即產生摘要或發送最新摘要，可使用右上角導航列的
      <span class="material-symbols-rounded" aria-hidden="true" style="font-size:16px; vertical-align:-3px;">auto_awesome</span>
      與
      <span class="material-symbols-rounded" aria-hidden="true" style="font-size:16px; vertical-align:-3px;">forward_to_inbox</span>
      按鈕。
    </p>

    <div style="min-height:1.5rem; margin-bottom:var(--space-4);">
      <span id="summary-action-status" style="font-size:var(--font-size-sm); color:var(--color-text-tertiary);"></span>
    </div>

    {error && (
      <div style="color:var(--color-error); margin-bottom:var(--space-4);">
        查詢失敗：{error.message}
      </div>
    )}

    <div style="display:flex; flex-direction:column; gap:var(--space-3);">
      {summaries.map((s) => (
        <div class="card" style="padding:var(--space-4);">
          <div style="display:flex; justify-content:space-between; align-items:center; gap:var(--space-4); margin-bottom:var(--space-2);">
            <span class="badge" style="background:var(--color-primary-muted); color:var(--color-primary-hover);">
              {s.email_count} 封未讀
            </span>
            <div style="display:flex; align-items:center; gap:var(--space-3);">
              <button
                type="button"
                class="btn btn-outline send-summary-btn"
                data-summary-id={s.id}
                style="padding:var(--space-1) var(--space-3); font-size:var(--font-size-xs);"
              >
                發送至 Discord
              </button>
              <time datetime={s.created_at} style="font-size:var(--font-size-xs); color:var(--color-text-tertiary);">
                {new Date(s.created_at).toLocaleString("zh-TW")}
              </time>
            </div>
          </div>
          <div style="font-size:var(--font-size-xs); color:var(--color-text-tertiary); margin-bottom:var(--space-2);">
            涵蓋期間：{new Date(s.period_start).toLocaleString("zh-TW")} ～ {new Date(s.period_end).toLocaleString("zh-TW")}
          </div>
          <p style="white-space:pre-line; font-size:var(--font-size-sm); color:var(--color-text);">
            {s.summary_text}
          </p>
        </div>
      ))}

      {summaries.length === 0 && !error && (
        <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
          尚無摘要記錄，等待下一次每小時排程執行。
        </div>
      )}
    </div>

    <script>
      document.addEventListener("astro:page-load", () => {
        if (window.location.pathname !== "/summaries") return;
        const status = document.querySelector<HTMLElement>("#summary-action-status");

        function setStatus(text: string, tone: "info" | "error" = "info") {
          if (!status) return;
          status.textContent = text;
          status.style.color = tone === "error" ? "var(--color-error)" : "var(--color-text-tertiary)";
        }

        async function postJson(url: string, body: unknown) {
          const res = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || "請求失敗");
          return data;
        }

        document.querySelectorAll<HTMLButtonElement>(".send-summary-btn").forEach((btn) => {
          btn.addEventListener("click", async () => {
            btn.disabled = true;
            const original = btn.textContent;
            btn.textContent = "發送中…";
            try {
              await postJson("/api/summaries/send-discord", { summaryId: btn.dataset.summaryId });
              btn.textContent = "已發送";
              setStatus("已將該筆摘要發送至 Discord。");
            } catch (err) {
              btn.textContent = "發送失敗";
              setStatus(err instanceof Error ? err.message : "發送失敗，請稍後再試。", "error");
            } finally {
              window.setTimeout(() => { btn.textContent = original; btn.disabled = false; }, 1500);
            }
          });
        });
      });
    </script>
</SidebarLayout>
