# =====================================================
# 環境變數範本
# =====================================================
# 使用方式：
#   1. 複製此檔案為 .env：
#      cp .env.example .env
#   2. 填入實際的值（.env 已在 .gitignore 中，不會被提交）
# =====================================================

# 網站基礎 URL（用於 canonicalURL 與 og:image 路徑）
# PUBLIC_ 前綴代表此變數可在前端 JavaScript 中存取
PUBLIC_SITE_URL=https://your-domain.com

# 網站名稱（顯示在頁面標題與 SEO 中）
PUBLIC_SITE_NAME=My Astro Site

# Cloudflare Pages 與 D1 的正式設定放在 wrangler.jsonc，
# 不要把 database_id 或 API Token 放進前端環境變數。

# ─── 其他整合（視需要填入） ───

# 範例：資料庫連線（僅在伺服器端使用，不加 PUBLIC_ 前綴）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 範例：第三方 API 金鑰（僅在伺服器端使用）
# API_SECRET_KEY=your_secret_key_here
