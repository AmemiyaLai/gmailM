---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import EmailCard from "../components/EmailCard.astro";
import FilterBar from "../components/FilterBar.astro";
import SummaryPanel from "../components/SummaryPanel.astro";
import StatsRow from "../components/StatsRow.astro";
import {
  getLatestSummary,
  getUnreadCount,
  getTodayCount,
  getCategoryCounts,
  getImportantEmails,
  listEmails,
} from "../lib/emailQueries";
import { parseEmailFilterParams, buildFilterHref } from "../lib/emailFilters";

const filters = parseEmailFilterParams(Astro.url);

const [summary, unreadCount, todayCount, categoryCounts, importantEmails, { emails: recentUnread }] =
  await Promise.all([
    getLatestSummary(),
    getUnreadCount(),
    getTodayCount(),
    getCategoryCounts(),
    getImportantEmails(5),
    listEmails({
      category: filters.category,
      sender: filters.sender,
      recipient: filters.recipient,
      from: filters.from,
      to: filters.to,
      onlyUnread: true,
      limit: 10,
    }),
  ]);
---

<SidebarLayout title="Gmail 即時監控面板" activeView="home">
  <SummaryPanel summary={summary} />

  <StatsRow
    unreadCount={unreadCount}
    todayCount={todayCount}
    categoryCounts={categoryCounts}
    importantEmails={importantEmails}
  />

  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-3);">
    <h2 style="font-size:var(--font-size-md);">最近未讀郵件</h2>
    <a href={buildFilterHref("/unread", filters)} style="font-size:var(--font-size-sm); color:var(--color-primary-hover);">
      查看全部未讀 →
    </a>
  </div>

  <FilterBar
    action="/"
    category={filters.category}
    sender={filters.sender}
    recipient={filters.recipient}
    from={filters.from}
    to={filters.to}
    showUnreadToggle={false}
  />

  <div id="email-list" style="display:flex; flex-direction:column; gap:var(--space-3);">
    {recentUnread.map((email) => (
      <EmailCard
        id={email.id}
        sender={email.sender}
        subject={email.subject}
        snippet={email.snippet}
        receivedAt={email.received_at}
        isRead={email.is_read}
        category={email.category}
        isImportant={email.is_important}
        isStarred={email.is_starred}
        compact
      />
    ))}

    {recentUnread.length === 0 && (
      <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
        目前沒有未讀郵件。
      </div>
    )}
  </div>

  <script>
    import Pusher from "pusher-js";
    import { buildEmailRowElement } from "../lib/emailCardHtml";
    import { initEmailList } from "../lib/emailListClient";

    const statusEl = document.getElementById("connection-status")!;
    const listEl = document.getElementById("email-list")!;

    initEmailList(listEl);

    const importantRowEl = document.getElementById("important-email-row");
    if (importantRowEl) initEmailList(importantRowEl);

    const pusher = new Pusher(import.meta.env.PUBLIC_PUSHER_KEY, {
      cluster: import.meta.env.PUBLIC_PUSHER_CLUSTER,
    });

    const channel = pusher.subscribe("gmail-channel");

    channel.bind("pusher:subscription_succeeded", () => {
      statusEl.textContent = "已連線";
      statusEl.style.background = "var(--color-primary-muted)";
      statusEl.style.color = "var(--color-primary-hover)";
    });

    channel.bind("pusher:subscription_error", () => {
      statusEl.textContent = "連線失敗";
      statusEl.style.background = "rgba(239,68,68,0.15)";
      statusEl.style.color = "var(--color-error)";
    });

    channel.bind(
      "new-email",
      (data: {
        id: string;
        sender: string;
        subject: string;
        snippet: string;
        received_at: string;
        category?: string;
        is_important?: boolean;
        is_starred?: boolean;
      }) => {
        listEl.prepend(buildEmailRowElement(data));
      },
    );
  </script>
</SidebarLayout>
