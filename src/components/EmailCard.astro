---
import { categoryBadge } from "../lib/categoryBadge";
import { formatEmailDate } from "../lib/formatEmailDate";
import { extractSenderName } from "../lib/senderUtils";

export interface Props {
  id: string;
  sender: string;
  subject: string;
  snippet: string;
  receivedAt: string;
  isRead: boolean;
  category: string | null;
  isImportant?: boolean;
  isStarred?: boolean;
  isFirstSender?: boolean;
  compact?: boolean;
  showCheckbox?: boolean;
  rowStyle?: string;
}

const {
  id,
  sender,
  subject,
  snippet,
  receivedAt,
  isRead,
  category,
  isImportant = false,
  isStarred = false,
  isFirstSender = false,
  compact = false,
  showCheckbox = true,
  rowStyle = "",
} = Astro.props;

const badge = categoryBadge(category);
const formattedDate = formatEmailDate(receivedAt);
---

<div
  class="email-row"
  class:list={{ "email-row--unread": !isRead, "email-row--important": isImportant }}
  data-id={id}
  data-read={isRead ? "true" : "false"}
  data-starred={isStarred ? "true" : "false"}
  style={rowStyle}
>
  {showCheckbox && <input type="checkbox" class="email-checkbox" aria-label="選取郵件" />}

  <button type="button" class="star-btn" aria-label="加星號" aria-pressed={isStarred ? "true" : "false"}>
    <span class="material-symbols-rounded email-action-icon star-icon" class:list={{ starred: isStarred }} aria-hidden="true">star</span>
  </button>

  <a href={`/emails/${id}`} class="email-link">
    <span class="unread-dot"></span>
    <span class="email-sender">{extractSenderName(sender)}</span>
    <span class="email-subject">{subject || "(無主旨)"}</span>
    {!compact && <span class="email-snippet">— {snippet}</span>}
    {badge && (
      <span class="badge chip" style={`background:${badge.bg}; color:${badge.color};`}>
        {badge.label}
      </span>
    )}
    {isFirstSender && <span class="badge chip first-sender-chip">首次寄件者</span>}
  </a>

  <div class="email-meta">
    <time class="email-date" datetime={receivedAt}>{formattedDate}</time>
    <div class="email-actions">
      <button type="button" class="action-btn" data-action="read" title={isRead ? "標示為未讀" : "標示為已讀"}>
        <span class="material-symbols-rounded email-action-icon" aria-hidden="true">mail</span>
      </button>
      <button type="button" class="action-btn" data-action="archive" title="封存">
        <span class="material-symbols-rounded email-action-icon" aria-hidden="true">archive</span>
      </button>
      <button type="button" class="action-btn" data-action="trash" title="刪除">
        <span class="material-symbols-rounded email-action-icon" aria-hidden="true">delete</span>
      </button>
    </div>
  </div>
</div>

<style>
  .email-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: var(--color-surface);
    transition: box-shadow var(--transition-fast), background-color var(--transition-fast);
  }

  .email-row:hover {
    box-shadow: var(--shadow-sm);
    z-index: 1;
    position: relative;
  }

  .email-row--unread .email-sender,
  .email-row--unread .email-subject {
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .email-row--important {
    border-left: 3px solid var(--color-error);
  }

  .email-checkbox {
    flex-shrink: 0;
    cursor: pointer;
    accent-color: var(--color-primary);
  }

  .star-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1);
  }

  .star-icon {
    color: var(--color-text-tertiary);
    font-size: 18px;
  }

  .star-icon.starred {
    color: var(--color-warning);
    font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 24;
  }

  .email-action-icon {
    font-size: 16px;
  }

  .unread-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    flex-shrink: 0;
    visibility: hidden;
  }

  .email-row--unread .unread-dot {
    visibility: visible;
  }

  .email-link {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .email-sender {
    flex-shrink: 0;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .email-subject {
    flex-shrink: 0;
    max-width: 40%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .email-snippet {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
  }

  .chip {
    flex-shrink: 0;
  }

  .first-sender-chip {
    background: rgba(249, 115, 22, 0.15);
    color: #c2410c;
  }

  .email-meta {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 96px;
  }

  .email-date {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .email-actions {
    display: none;
    align-items: center;
    gap: var(--space-1);
  }

  .email-row:hover .email-date {
    display: none;
  }

  .email-row:hover .email-actions {
    display: flex;
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1);
    border: none;
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .action-btn:hover {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .email-row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      min-width: 860px;
      min-height: 54px;
      padding: var(--space-2) var(--space-3);
    }

    .email-row--important {
      padding-left: calc(var(--space-3) - 3px);
    }

    .email-checkbox {
      width: 18px;
      height: 18px;
    }

    .star-btn {
      width: 36px;
      height: 36px;
      padding: var(--space-1);
    }

    .star-icon {
      font-size: 21px;
    }

    .email-link {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 40px;
    }

    .email-sender {
      max-width: 160px;
      font-size: var(--font-size-sm);
    }

    .email-subject {
      max-width: 40%;
      font-size: var(--font-size-sm);
    }

    .email-snippet {
      font-size: var(--font-size-sm);
    }

    .email-meta {
      width: auto;
      min-width: 220px;
      min-height: 40px;
      justify-content: flex-end;
      gap: var(--space-3);
    }

    .email-actions,
    .email-row:hover .email-actions {
      display: flex;
      gap: var(--space-2);
    }

    .email-row:hover .email-date {
      display: block;
    }

    .action-btn {
      width: 36px;
      height: 36px;
      padding: 0;
      background: var(--color-bg-secondary);
    }

    .email-action-icon {
      font-size: 18px;
    }
  }
</style>
