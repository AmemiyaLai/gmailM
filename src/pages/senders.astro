---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import StatCard from "../components/StatCard.astro";
import { getSenderStats } from "../lib/emailQueries";
import { formatEmailDate } from "../lib/formatEmailDate";
import { extractSenderName } from "../lib/senderUtils";
import { getSenderTags } from "../lib/senderTagService";
import { senderKey, SENDER_TAGS, senderTagLabels } from "../lib/senderTags";
import { getSupabase } from "../lib/supabase";

const stats = await getSenderStats(2);
const senderTags = await getSenderTags(getSupabase());
---

<SidebarLayout title="常見寄件者 — Gmail 即時監控面板" activeView="senders">
  <h1 style="font-size:var(--font-size-2xl); margin-bottom:var(--space-6);">常見寄件者</h1>

  <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:var(--space-4); margin-bottom:var(--space-8);">
    <StatCard label="常見寄件者數" value={stats.length} accent="primary" />
  </div>

  <div style="margin:-1rem 0 var(--space-4); display:flex; align-items:center; gap:var(--space-3);">
    <button type="button" class="btn btn-outline" id="refresh-sender-tags">自動整理標籤</button>
    <span id="refresh-sender-tags-status" style="font-size:var(--font-size-sm); color:var(--color-text-tertiary);"></span>
  </div>

  {stats.length === 0 ? (
    <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
      目前沒有寄信 ≥2 次的寄件者。
    </div>
  ) : (
    <div style="border:1px solid var(--color-border); border-radius:var(--radius-md); overflow:hidden;">
      <table style="width:100%; border-collapse:collapse; font-size:var(--font-size-sm);">
        <thead>
          <tr style="background:var(--color-bg-secondary); border-bottom:1px solid var(--color-border);">
            <th style="padding:var(--space-3) var(--space-4); text-align:left; font-weight:var(--font-weight-medium); color:var(--color-text-secondary);">寄件者</th>
            <th style="padding:var(--space-3) var(--space-4); text-align:right; font-weight:var(--font-weight-medium); color:var(--color-text-secondary);">次數</th>
            <th style="padding:var(--space-3) var(--space-4); text-align:left; font-weight:var(--font-weight-medium); color:var(--color-text-secondary);">最新來信</th>
            <th style="padding:var(--space-3) var(--space-4); text-align:left; font-weight:var(--font-weight-medium); color:var(--color-text-secondary);">寄件者標籤</th>
            <th style="padding:var(--space-3) var(--space-4); text-align:left; font-weight:var(--font-weight-medium); color:var(--color-text-secondary);">操作</th>
          </tr>
        </thead>
        <tbody>
          {stats.map((stat) => {
            const tagInfo = senderTags.get(senderKey(stat.sender));
            return (
              <tr class="sender-row" data-sender={stat.sender} style="border-bottom:1px solid var(--color-border-subtle);">
                <td style="padding:var(--space-3) var(--space-4);">
                  <a href={`/emails?sender=${encodeURIComponent(stat.sender)}`} style="color:var(--color-primary-hover); text-decoration:none; font-weight:var(--font-weight-medium);">
                    {extractSenderName(stat.sender)}
                  </a>
                </td>
                <td style="padding:var(--space-3) var(--space-4); text-align:right; font-weight:var(--font-weight-bold); color:var(--color-text);">
                  {stat.count}
                </td>
                <td style="padding:var(--space-3) var(--space-4); color:var(--color-text-tertiary); white-space:nowrap;">
                  {formatEmailDate(stat.latestReceivedAt)}
                </td>
                <td style="padding:var(--space-3) var(--space-4);">
                  {tagInfo ? (
                    <span class="badge" style="background:var(--color-primary-muted); color:var(--color-primary-hover);">
                      {senderTagLabels[tagInfo.tag]}{tagInfo.source === "manual" ? "（手動）" : tagInfo.was_aggregated ? "（已聚合）" : ""}
                    </span>
                  ) : (
                    <span style="color:var(--color-text-tertiary);">尚未整理</span>
                  )}
                </td>
                <td style="padding:var(--space-3) var(--space-4);">
                  <div style="display:flex; align-items:center; gap:var(--space-2);">
                    <select class="sender-tag-select" style="padding:var(--space-1) var(--space-2); border:1px solid var(--color-border); border-radius:var(--radius-sm); background:var(--color-surface); color:var(--color-text); font-size:var(--font-size-xs);">
                      {SENDER_TAGS.map((tag) => (
                        <option value={tag} selected={tag === tagInfo?.tag}>{senderTagLabels[tag]}</option>
                      ))}
                    </select>
                    <button type="button" class="btn btn-outline sender-apply-btn" style="padding:var(--space-1) var(--space-3); font-size:var(--font-size-xs);">套用</button>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  <script>
    import { navigate } from "astro:transitions/client";

    document.addEventListener("astro:page-load", () => {
      if (window.location.pathname !== "/senders") return;

      document.querySelectorAll<HTMLTableRowElement>(".sender-row").forEach((row) => {
        const btn = row.querySelector<HTMLButtonElement>(".sender-apply-btn");
        const select = row.querySelector<HTMLSelectElement>(".sender-tag-select");
        if (!btn || !select) return;

        const sender = row.dataset.sender!;
        btn.addEventListener("click", async () => {
          btn.disabled = true;
          try {
            const res = await fetch("/api/senders/tag", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ sender, tag: select.value }),
            });
            if (!res.ok) throw new Error("Failed");
            btn.textContent = "已套用";
            setTimeout(() => { btn.textContent = "套用"; }, 1500);
          } catch {
            btn.textContent = "失敗";
            setTimeout(() => { btn.textContent = "套用"; }, 1500);
          } finally {
            btn.disabled = false;
          }
        });
      });

      const refresh = document.querySelector<HTMLButtonElement>("#refresh-sender-tags");
      const status = document.querySelector<HTMLElement>("#refresh-sender-tags-status");
      refresh?.addEventListener("click", async () => {
        refresh.disabled = true;
        if (status) status.textContent = "整理中…";
        try {
          const res = await fetch("/api/senders/tags/refresh", { method: "POST" });
          const result = await res.json() as { processed?: number; aggregated?: number };
          if (!res.ok) throw new Error("Failed");
          if (status) status.textContent = `已整理 ${result.processed ?? 0} 位寄件者，聚合 ${result.aggregated ?? 0} 個標籤。`;
          window.setTimeout(() => navigate("/senders", { history: "replace" }), 600);
        } catch {
          if (status) status.textContent = "整理失敗，請稍後再試。";
        } finally { refresh.disabled = false; }
      });
    });
  </script>
</SidebarLayout>
