---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";

export interface Props {
  title: string;
  description?: string;
  showSummaries?: boolean;
  activeView?: "home" | "all" | "unread" | "important" | "search" | "summaries" | "senders";
  activeCategory?: string | null;
}

const {
  title,
  description,
  showSummaries = true,
  activeView,
  activeCategory,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="app-shell">
    <Sidebar activeView={activeView} activeCategory={activeCategory} />
    <div class="app-main">
      <Header showSummaries={showSummaries} />
      <main class="container" style="padding: var(--space-6) 0 var(--space-12) 0;">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>
