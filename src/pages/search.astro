---
import { KnowledgeLayout } from "@amemiyalai/wiki-center/astro";
import { site } from "../site.config";
const query = Astro.url.searchParams.get("q") ?? "";
---

<KnowledgeLayout site={site} title="搜尋" description="搜尋知識庫內容。" showSidebar={false}>
  <h1>搜尋知識庫</h1>
  <p>搜尋介面已就緒；可在此頁接入你的 SearchProvider 或 Cloudflare 搜尋服務。</p>
  <form action="/search" role="search"><label for="q">搜尋</label><input id="q" name="q" type="search" value={query} placeholder="輸入關鍵字" /><button type="submit">搜尋</button></form>
</KnowledgeLayout>
