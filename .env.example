# =====================================================
# 環境變數範本 — Gmail 即時監控面板
# =====================================================
# 使用方式：
#   1. 複製此檔案為 .env：
#      cp .env.example .env
#   2. 填入實際的值（.env 已在 .gitignore 中，不會被提交）
# =====================================================

# ─── Supabase（僅伺服器端使用） ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Pusher Channels ───
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=your_cluster

# 前端公開變數（不含 secret）
PUBLIC_PUSHER_KEY=your_key
PUBLIC_PUSHER_CLUSTER=your_cluster

# ─── Gmail OAuth2 ───
GMAIL_OAUTH_CLIENT_ID=your_client_id
GMAIL_OAUTH_CLIENT_SECRET=your_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=your_refresh_token
GMAIL_WATCH_ADDRESS=your_email@gmail.com

# ─── Google Cloud Pub/Sub ───
GCP_PROJECT_ID=your_project_id
PUBSUB_TOPIC=gmail-notifications
PUBSUB_AUDIENCE=https://mail.yourdomain.com/api/webhook/gmail
# 訂閱上 pushConfig.oidcToken.serviceAccountEmail 的值，用來驗證 push 請求來源：
#   gcloud pubsub subscriptions list --project=$GCP_PROJECT_ID \
#     --format="table(name, pushConfig.oidcToken.serviceAccountEmail, pushConfig.oidcToken.audience)"
PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-push@your_project_id.iam.gserviceaccount.com

# ─── Vercel Cron 驗證 ───
CRON_SECRET=your_random_secret_here

# ─── Discord Webhook（重要郵件與首次寄件者安全通知） ───
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# ─── Discord Bot（關鍵字清理審核訊息，Webhook 無法附帶按鈕故需 Bot） ───
# 1. Developer Portal 建立 Application + Bot，邀請進伺服器（需 Send Messages 權限）
# 2. Interactions Endpoint URL 設為 https://your-domain/api/discord/interactions
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CLEANUP_CHANNEL_ID=your_channel_id
DISCORD_PUBLIC_KEY=your_application_public_key

# ─── Google Gemini API（郵件摘要與重要性判斷） ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ─── 網站網址（Discord 通知中的管理頁面連結） ───
SITE_URL=https://mail.yourdomain.com
