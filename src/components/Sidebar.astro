---
import { categoryBadge } from "../lib/categoryBadge";
import { categories } from "../lib/classify";

export interface Props {
  activeView?: "home" | "all" | "unread" | "important" | "search" | "summaries" | "senders";
  activeCategory?: string | null;
}

const { activeView = null, activeCategory = null } = Astro.props;
---

<aside class="app-sidebar">
  <nav class="sidebar-nav">
    <div class="sidebar-section">
      <a href="/" class:list={["sidebar-link", { active: activeView === "home" }]}>
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" /><rect x="14" y="3" width="7" height="5" /><rect x="14" y="12" width="7" height="9" /><rect x="3" y="16" width="7" height="5" /></svg>
        儀表板
      </a>
      <a href="/emails" class:list={["sidebar-link", { active: activeView === "all" }]}>
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" /><path d="M4 8h16M8 8v12" /></svg>
        全部郵件
      </a>
      <a href="/unread" class:list={["sidebar-link", { active: activeView === "unread" }]}>
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" /><path d="m4 4 8 8 8-8" /></svg>
        未讀郵件
      </a>
      <a href="/emails?important=1" class:list={["sidebar-link", { active: activeView === "important" }]}>
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.63 22 9.24 17 14.14 18.18 21 12 17.77 5.82 21 7 14.14 2 9.24 8.91 8.63 12 2" /></svg>
        重要郵件
      </a>
      <a href="/senders" class:list={["sidebar-link", { active: activeView === "senders" }]}>
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        常見寄件者
      </a>
    </div>

    <div class="sidebar-section">
      <span class="sidebar-heading">分類</span>
      {categories.map((category) => {
        const badge = categoryBadge(category);
        return (
          <a
            href={`/emails?category=${encodeURIComponent(category)}`}
            class:list={["sidebar-link", { active: activeCategory === category }]}
          >
            {badge && <span class="sidebar-dot" style={`background:${badge.bg};`}></span>}
            {badge?.label ?? category}
          </a>
        );
      })}
    </div>

    <div class="sidebar-section">
      <a href="/summaries" class:list={["sidebar-link", { active: activeView === "summaries" }]}>
        <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
        摘要記錄
      </a>
    </div>
  </nav>
</aside>

<style>
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-4);
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .sidebar-heading {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-2) var(--space-3);
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .sidebar-link:hover {
    background-color: var(--color-bg-tertiary);
    color: var(--color-text);
  }

  .sidebar-link.active {
    background-color: var(--color-primary-muted);
    color: var(--color-primary-hover);
    font-weight: var(--font-weight-medium);
  }

  .sidebar-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.8;
  }

  .sidebar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .sidebar-nav {
      flex-direction: row;
      overflow-x: auto;
      padding: var(--space-3) var(--space-4);
      gap: var(--space-4);
    }

    .sidebar-section {
      flex-direction: row;
      flex-shrink: 0;
    }

    .sidebar-heading {
      display: none;
    }

    .sidebar-link {
      white-space: nowrap;
    }
  }
</style>
