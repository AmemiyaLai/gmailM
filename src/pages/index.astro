---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import EmailCard from "../components/EmailCard.astro";
import FilterBar from "../components/FilterBar.astro";
import SummaryPanel from "../components/SummaryPanel.astro";
import StatsRow from "../components/StatsRow.astro";
import SenderGroupGrid from "../components/SenderGroupGrid.astro";
import {
  getLatestSummary,
  getUnreadCount,
  getTodayCount,
  getCategoryCounts,
  getDashboardStatTrends,
  getImportantEmails,
  listEmails,
  getSenderGroupUnreadCounts,
  getSenderGroupTopSenders,
} from "../lib/emailQueries";
import { parseEmailFilterParams, buildFilterHref } from "../lib/emailFilters";
import { SENDER_GROUPS } from "../lib/senderGroups";

const filters = parseEmailFilterParams(Astro.url);

const [summary, unreadCount, todayCount, categoryCounts, importantEmails, { emails: recentUnread }, groupUnreadCounts, groupTopSenders] =
  await Promise.all([
    getLatestSummary(),
    getUnreadCount(),
    getTodayCount(),
    getCategoryCounts(),
    getImportantEmails(5),
    listEmails({
      category: filters.category,
      sender: filters.sender,
      recipient: filters.recipient,
      from: filters.from,
      to: filters.to,
      onlyUnread: true,
      limit: 10,
    }),
    getSenderGroupUnreadCounts(SENDER_GROUPS),
    getSenderGroupTopSenders(SENDER_GROUPS, 8),
  ]);

const overviewCategoryCounts = categoryCounts.filter(({ category }) => category === "system" || category === "uncategorized");
const overviewCategorySnapshot = Object.fromEntries(overviewCategoryCounts.map(({ category, count }) => [category, count]));
const statTrends = await getDashboardStatTrends(unreadCount, todayCount, groupUnreadCounts, overviewCategorySnapshot);
---

<SidebarLayout title="Gmail 即時監控面板" activeView="home">
  <!-- 摘要區：左 50% AI 摘要 / 右 50% 寄信者群組卡片 -->
  <div class="summary-split">
    <div class="summary-split-left">
      <SummaryPanel summary={summary} />
    </div>
    <div class="summary-split-right">
      <SenderGroupGrid groups={SENDER_GROUPS} unreadCounts={groupUnreadCounts} topSenders={groupTopSenders} trends={statTrends.groups} />
    </div>
  </div>

  <StatsRow
    unreadCount={unreadCount}
    todayCount={todayCount}
    categoryCounts={overviewCategoryCounts}
    trends={statTrends}
    importantEmails={importantEmails}
  />

  <div class="recent-unread-toolbar">
    <h2>最近未讀郵件</h2>
    <FilterBar
      action="/"
      category={filters.category}
      sender={filters.sender}
      recipient={filters.recipient}
      from={filters.from}
      to={filters.to}
      showUnreadToggle={false}
    />
    <a href={buildFilterHref("/unread", filters)}>查看全部未讀 →</a>
  </div>

  <div id="email-list" class="recent-unread-list" data-unread-only="true">
    {recentUnread.map((email) => (
      <EmailCard
        id={email.id}
        sender={email.sender}
        subject={email.subject}
        snippet={email.snippet}
        receivedAt={email.received_at}
        isRead={email.is_read}
        category={email.category}
        isImportant={email.is_important}
        isStarred={email.is_starred}
        isFirstSender={email.is_first_sender}
        compact
      />
    ))}

    {recentUnread.length === 0 && (
      <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
        目前沒有未讀郵件。
      </div>
    )}
  </div>

  <script>
    import { initEmailList } from "../lib/emailListClient";

    document.addEventListener("astro:page-load", () => {
      if (window.location.pathname !== "/") return;
      const listEl = document.getElementById("email-list");
      if (listEl) initEmailList(listEl);

      const importantRowEl = document.getElementById("important-email-row");
      if (importantRowEl) initEmailList(importantRowEl);
    });
  </script>

  <style>
    /* 最近未讀郵件固定為單欄清單，避免卡片隨版面寬度分成多欄。 */
    .recent-unread-list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      width: 100%;
    }

    .recent-unread-toolbar {
      display: flex;
      align-items: center;
      column-gap: var(--space-4);
      row-gap: var(--space-2);
      margin-bottom: var(--space-3);
    }

    .recent-unread-toolbar h2 {
      flex-shrink: 0;
      margin: 0;
      font-size: var(--font-size-md);
      white-space: nowrap;
    }

    .recent-unread-toolbar :global(.filter-bar) {
      flex: 0 1 auto;
      margin: 0;
    }

    .recent-unread-toolbar :global(.filter-row) {
      flex-wrap: nowrap;
      gap: var(--space-1);
    }

    /* 僅縮小首頁工具列的篩選按鈕，避免影響其他頁面的篩選介面。 */
    .recent-unread-toolbar :global(.chip-trigger),
    .recent-unread-toolbar :global(.chip-select) {
      min-height: 0;
      padding: 2px var(--space-3);
      line-height: 1.35;
    }

    .recent-unread-toolbar a {
      margin-left: auto;
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-medium);
      color: var(--color-primary-hover);
      white-space: nowrap;
    }

    @media (max-width: 760px) {
      .recent-unread-toolbar {
        flex-wrap: wrap;
      }

      .recent-unread-toolbar :global(.filter-bar) {
        order: 3;
        flex-basis: 100%;
      }

      .recent-unread-toolbar :global(.filter-row) {
        flex-wrap: wrap;
      }
    }
  </style>
</SidebarLayout>
