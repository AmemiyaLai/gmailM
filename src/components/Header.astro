---
/**
 * Header 元件
 * 提供包含網頁左上角 Logo、品牌標題與頂部導航之共用導航列。
 */
export interface Props {
  /** 是否顯示摘要記錄按鈕 */
  showSummaries?: boolean;
}

const { showSummaries = true } = Astro.props;
---

<header class="site-header">
  <div class="container header-content">
    <!-- 左上角 品牌 Logo 區塊 -->
    <a href="/" class="brand-link" title="回 Gmail Monitor 首頁">
      <div class="logo-wrapper">
        <img src="/logo.svg" alt="Gmail Monitor Logo" class="brand-logo" width="36" height="36" />
        <span class="status-pulse"></span>
      </div>
      <div class="brand-info">
        <span class="brand-name">Gmail<span class="brand-accent">Monitor</span></span>
        <span class="brand-sub">即時監控系統</span>
      </div>
    </a>

    <!-- 右側導航與連線狀態 -->
    <nav class="header-nav">
      <div class="header-search-wrap">
        <button id="search-toggle" type="button" class="btn btn-outline nav-btn search-toggle-btn" title="搜尋郵件" aria-label="搜尋郵件" aria-expanded="false">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <form id="header-search-form" class="header-search" action="/search" method="get">
          <input type="text" name="q" id="header-search-input" placeholder="搜尋寄件者 / 主旨 / 內文摘要" autocomplete="off" />
        </form>
      </div>
      {showSummaries && (
        <a href="/summaries" class="btn btn-outline nav-btn">
          <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <span>摘要記錄</span>
        </a>
      )}
      <span id="connection-status" class="badge connection-badge">
        連線中...
      </span>
      <button id="sync-now" type="button" class="btn btn-outline nav-btn" title="立即從 Gmail 同步最新郵件">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M23 4v6h-6"></path>
          <path d="M1 20v-6h6"></path>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
        </svg>
        <span>立即同步</span>
      </button>
      <button id="theme-toggle" type="button" class="btn btn-outline nav-btn theme-toggle-btn" title="切換主題" aria-label="切換主題">
        <svg id="theme-icon-light" class="theme-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg id="theme-icon-dark" class="theme-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    var lightIcon = document.getElementById("theme-icon-light");
    var darkIcon = document.getElementById("theme-icon-dark");

    function syncIcons() {
      var isDark = document.documentElement.dataset.theme === "dark";
      lightIcon.style.display = isDark ? "none" : "block";
      darkIcon.style.display = isDark ? "block" : "none";
    }

    syncIcons();

    btn.addEventListener("click", function () {
      var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("theme", next);
      syncIcons();
    });
  })();
</script>

<script is:inline>
  (function () {
    var syncBtn = document.getElementById("sync-now");
    var syncLabel = syncBtn.querySelector("span");
    var defaultLabel = syncLabel.textContent;

    syncBtn.addEventListener("click", function () {
      if (syncBtn.disabled) return;
      syncBtn.disabled = true;
      syncLabel.textContent = "同步中...";

      fetch("/api/gmail/sync", { method: "POST" })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          syncLabel.textContent = result.error ? "同步失敗" : "已同步 " + result.imported + " 封";
          if (!result.error) {
            setTimeout(function () { window.location.reload(); }, 800);
          }
        })
        .catch(function () {
          syncLabel.textContent = "同步失敗";
        })
        .finally(function () {
          setTimeout(function () {
            syncBtn.disabled = false;
            syncLabel.textContent = defaultLabel;
          }, 2500);
        });
    });
  })();
</script>

<script is:inline>
  (function () {
    var wrap = document.querySelector(".header-search-wrap");
    var toggleBtn = document.getElementById("search-toggle");
    var input = document.getElementById("header-search-input");

    function close() {
      wrap.classList.remove("header-search-wrap--open");
      toggleBtn.setAttribute("aria-expanded", "false");
    }

    function open() {
      wrap.classList.add("header-search-wrap--open");
      toggleBtn.setAttribute("aria-expanded", "true");
      input.focus();
    }

    toggleBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      if (wrap.classList.contains("header-search-wrap--open")) {
        close();
      } else {
        open();
      }
    });

    wrap.addEventListener("click", function (e) {
      e.stopPropagation();
    });

    document.addEventListener("click", close);

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close();
    });
  })();
</script>

<style>
  .site-header {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-3) 0;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .brand-link:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .logo-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-logo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.3);
    object-fit: contain;
    transition: box-shadow var(--transition-base);
  }

  .brand-link:hover .brand-logo {
    box-shadow: 0 0 18px rgba(99, 102, 241, 0.6);
  }

  .status-pulse {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 8px;
    height: 8px;
    background-color: var(--color-success);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-success);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .brand-accent {
    color: var(--color-primary-hover);
    margin-left: 2px;
  }

  .brand-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-regular);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
    border-radius: var(--radius-full);
  }

  .search-icon {
    opacity: 0.8;
  }

  .header-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-toggle-btn {
    padding: var(--space-2);
  }

  .header-search {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    width: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: width var(--transition-base), opacity var(--transition-base);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
  }

  .header-search-wrap--open .header-search {
    width: 260px;
    opacity: 1;
    pointer-events: auto;
  }

  .header-search input {
    width: 100%;
    padding: var(--space-2) var(--space-4);
    border: none;
    background: transparent;
    color: var(--color-text);
    border-radius: var(--radius-full);
  }

  .header-search input:focus {
    outline: none;
  }

  .theme-toggle-btn {
    padding: var(--space-2);
  }

  .theme-icon {
    display: block;
  }

  .connection-badge {
    background: var(--color-bg-tertiary);
    color: var(--color-text-tertiary);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
  }
</style>
