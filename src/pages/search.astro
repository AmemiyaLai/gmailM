---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import EmailCard from "../components/EmailCard.astro";
import FilterBar from "../components/FilterBar.astro";
import { getSupabase } from "../lib/supabase";
import { parseEmailFilterParams } from "../lib/emailFilters";

interface EmailResult {
  id: string;
  sender: string;
  subject: string;
  snippet: string;
  received_at: string;
  is_read: boolean;
  category: string | null;
  is_important?: boolean;
  labels: string[] | null;
}

const filters = parseEmailFilterParams(Astro.url);

const supabase = getSupabase();
let query = supabase
  .from("emails" as never)
  .select("id, sender, subject, snippet, received_at, is_read, category, is_important, labels")
  .order("received_at", { ascending: false })
  .limit(50);

if (filters.q) {
  query = query.textSearch("search_vector", filters.q, { type: "plain", config: "simple" });
}
if (filters.category) {
  query = query.eq("category", filters.category);
}
if (filters.from) {
  query = query.gte("received_at", new Date(filters.from).toISOString());
}
if (filters.to) {
  query = query.lte("received_at", new Date(filters.to).toISOString());
}
if (filters.sender) {
  query = query.ilike("sender", `%${filters.sender}%`);
}
if (filters.recipient) {
  query = query.ilike("recipient", `%${filters.recipient}%`);
}
if (filters.unread) {
  query = query.eq("is_read", false);
}

const { data, error } = await query;
const emails = (data ?? []) as EmailResult[];
---

<SidebarLayout title="搜尋 — Gmail 即時監控面板" activeView="search">
    <h1 style="font-size:var(--font-size-2xl); margin-bottom:var(--space-6);">搜尋郵件</h1>

    <FilterBar
      action="/search"
      q={filters.q}
      category={filters.category}
      sender={filters.sender}
      recipient={filters.recipient}
      from={filters.from}
      to={filters.to}
      unread={filters.unread}
    />

    {error && (
      <div style="color:var(--color-error); margin-bottom:var(--space-4);">
        查詢失敗：{error.message}
      </div>
    )}

    <div id="email-list" style="border:1px solid var(--color-border); border-radius:var(--radius-md); overflow:hidden;">
      {emails.map((email) => (
        <EmailCard
          id={email.id}
          sender={email.sender}
          subject={email.subject}
          snippet={email.snippet}
          receivedAt={email.received_at}
          isRead={email.is_read}
          category={email.category}
          isImportant={email.is_important}
          isStarred={(email.labels ?? []).includes("STARRED")}
        />
      ))}

      {emails.length === 0 && !error && (
        <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
          沒有符合條件的郵件。
        </div>
      )}
    </div>

    <script>
      import { initEmailList } from "../lib/emailListClient";
      initEmailList(document.getElementById("email-list")!);
    </script>
</SidebarLayout>
