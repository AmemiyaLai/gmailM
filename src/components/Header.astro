---
/**
 * Header 元件
 * 提供包含網頁左上角 Logo、品牌標題與頂部導航之共用導航列。
 */
---

<header class="site-header" transition:persist="site-header">
  <div class="container header-content">
    <!-- 左上角 品牌 Logo 區塊 -->
    <a href="/" class="brand-link" title="回 Gmail Monitor 首頁">
      <div class="logo-wrapper">
        <img src="/logo.svg" alt="Gmail Monitor Logo" class="brand-logo" width="36" height="36" />
        <span class="status-pulse"></span>
      </div>
      <div class="brand-info">
        <span class="brand-name">Gmail<span class="brand-accent">Monitor</span></span>
        <span class="brand-sub">即時監控系統</span>
      </div>
    </a>

    <!-- 右側導航與連線狀態 -->
    <nav class="header-nav">
      <div class="header-search-wrap">
        <form id="header-search-form" class="header-search" action="/search" method="get">
          <input type="text" name="q" id="header-search-input" placeholder="搜尋寄件者 / 主旨 / 內文摘要" autocomplete="off" />
        </form>
        <button id="search-toggle" type="button" class="btn btn-outline nav-btn search-toggle-btn" title="搜尋郵件" aria-label="搜尋郵件" aria-expanded="false">
          <span class="material-symbols-rounded search-icon" aria-hidden="true">search</span>
        </button>
      </div>
      <span id="connection-status" class="badge connection-badge">
        連線中...
      </span>
      <button id="sync-now" type="button" class="btn btn-outline nav-btn icon-only-btn" title="立即從 Gmail 同步最新郵件" aria-label="立即同步">
        <span class="material-symbols-rounded search-icon" aria-hidden="true">sync</span>
        <span class="sr-only" data-sync-label>立即同步</span>
      </button>
      <button id="generate-summary" type="button" class="btn btn-outline nav-btn icon-only-btn" title="立即產生未讀郵件的 AI 摘要" aria-label="立即產生 AI 摘要">
        <span class="material-symbols-rounded search-icon" data-summary-icon aria-hidden="true">auto_awesome</span>
        <span class="sr-only" data-summary-label>立即產生 AI 摘要</span>
      </button>
      <button id="send-summary-discord" type="button" class="btn btn-outline nav-btn icon-only-btn" title="將最新 AI 摘要發送至 Discord" aria-label="發送最新摘要至 Discord">
        <span class="material-symbols-rounded search-icon" data-discord-icon aria-hidden="true">forward_to_inbox</span>
        <span class="sr-only" data-discord-label>發送最新摘要至 Discord</span>
      </button>
      <button id="theme-toggle" type="button" class="btn btn-outline nav-btn theme-toggle-btn" title="切換主題" aria-label="切換主題">
        <span id="theme-icon-light" class="material-symbols-rounded theme-icon" aria-hidden="true">light_mode</span>
        <span id="theme-icon-dark" class="material-symbols-rounded theme-icon" aria-hidden="true" style="display:none;">dark_mode</span>
      </button>
    </nav>
  </div>
  <div id="header-action-toast" class="header-toast" role="status" aria-live="polite" hidden></div>
</header>

<script>
  import { navigate } from "astro:transitions/client";
  import { startRealtimeConnection } from "../lib/realtimeClient";

  const INITIAL_SYNC_KEY = "gmail-monitor:initial-sync-completed";

  startRealtimeConnection();

  const themeBtn = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const lightIcon = document.querySelector<HTMLElement>("#theme-icon-light");
  const darkIcon = document.querySelector<HTMLElement>("#theme-icon-dark");

  function syncThemeIcons() {
    const isDark = document.documentElement.dataset.theme === "dark";
    if (lightIcon) lightIcon.style.display = isDark ? "none" : "block";
    if (darkIcon) darkIcon.style.display = isDark ? "block" : "none";
  }

  syncThemeIcons();
  themeBtn?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
    syncThemeIcons();
  });

  const searchWrap = document.querySelector<HTMLElement>(".header-search-wrap");
  const searchToggle = document.querySelector<HTMLButtonElement>("#search-toggle");
  const searchInput = document.querySelector<HTMLInputElement>("#header-search-input");

  function closeSearch() {
    searchWrap?.classList.remove("header-search-wrap--open");
    searchToggle?.setAttribute("aria-expanded", "false");
  }

  searchToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const isOpen = searchWrap?.classList.contains("header-search-wrap--open");
    if (isOpen) {
      closeSearch();
    } else {
      searchWrap?.classList.add("header-search-wrap--open");
      searchToggle.setAttribute("aria-expanded", "true");
      searchInput?.focus();
    }
  });
  searchWrap?.addEventListener("click", (event) => event.stopPropagation());
  document.addEventListener("click", closeSearch);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSearch();
  });
  document.addEventListener("astro:after-swap", () => {
    const stored = localStorage.getItem("theme");
    document.documentElement.dataset.theme = stored === "light" ? "light" : "dark";
    syncThemeIcons();
  });

  async function syncEmails(automatic = false) {
    const syncBtn = document.querySelector<HTMLButtonElement>("#sync-now");
    const syncLabel = document.querySelector<HTMLElement>("[data-sync-label]");
    if (!syncBtn || !syncLabel || syncBtn.disabled) return;

    const defaultLabel = "立即同步";
    syncBtn.disabled = true;
    syncLabel.textContent = automatic ? "首次同步中..." : "同步中...";

    try {
      const res = await fetch("/api/gmail/sync", { method: "POST" });
      const result = await res.json();
      if (!res.ok || result.error) throw new Error(result.error || "同步失敗");

      sessionStorage.setItem(INITIAL_SYNC_KEY, "1");
      syncLabel.textContent = `已同步 ${result.imported ?? 0} 封`;

      if ((result.imported ?? 0) > 0) {
        window.setTimeout(() => {
          navigate(window.location.pathname + window.location.search, { history: "replace" });
        }, 500);
      }
    } catch {
      if (automatic) sessionStorage.removeItem(INITIAL_SYNC_KEY);
      syncLabel.textContent = "同步失敗";
    } finally {
      window.setTimeout(() => {
        syncBtn.disabled = false;
        syncLabel.textContent = defaultLabel;
      }, 2500);
    }
  }

  document.querySelector<HTMLButtonElement>("#sync-now")?.addEventListener("click", () => {
    void syncEmails(false);
  });

  const toast = document.querySelector<HTMLElement>("#header-action-toast");
  let toastTimer: number | undefined;

  function showToast(message: string, tone: "info" | "success" | "error" = "info") {
    if (!toast) return;
    toast.textContent = message;
    toast.dataset.tone = tone;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => { toast.hidden = true; }, 5000);
  }

  async function postJson(url: string, body: unknown) {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || "請求失敗");
    return data;
  }

  /** icon-only 按鈕在執行期間換成沙漏，結束後復原，避免使用者重複點擊 */
  async function runHeaderAction(
    btn: HTMLButtonElement,
    icon: HTMLElement | null,
    task: () => Promise<void>,
  ) {
    if (btn.disabled) return;
    const defaultIcon = icon?.textContent ?? "";
    btn.disabled = true;
    if (icon) icon.textContent = "hourglass_top";
    try {
      await task();
    } catch (err) {
      showToast(err instanceof Error ? err.message : "操作失敗，請稍後再試。", "error");
    } finally {
      if (icon) icon.textContent = defaultIcon;
      btn.disabled = false;
    }
  }

  const summaryBtn = document.querySelector<HTMLButtonElement>("#generate-summary");
  summaryBtn?.addEventListener("click", () => {
    const icon = summaryBtn.querySelector<HTMLElement>("[data-summary-icon]");
    void runHeaderAction(summaryBtn, icon, async () => {
      showToast("AI 摘要產生中…");
      const result = await postJson("/api/summaries/generate", { sendDiscord: false });

      if (result.status === "skipped") {
        showToast(
          result.reason === "no unread emails"
            ? "目前沒有未讀郵件，無需產生摘要。"
            : "已跳過：沒有新的未讀郵件。",
        );
        return;
      }

      showToast(`已產生 ${result.emailCount} 封未讀郵件的 AI 摘要。`, "success");
      if (window.location.pathname === "/summaries" || window.location.pathname === "/") {
        window.setTimeout(() => {
          navigate(window.location.pathname + window.location.search, { history: "replace" });
        }, 800);
      }
    });
  });

  const discordBtn = document.querySelector<HTMLButtonElement>("#send-summary-discord");
  discordBtn?.addEventListener("click", () => {
    const icon = discordBtn.querySelector<HTMLElement>("[data-discord-icon]");
    void runHeaderAction(discordBtn, icon, async () => {
      showToast("發送最新摘要至 Discord…");
      await postJson("/api/summaries/send-discord", {});
      showToast("已將最新 AI 摘要發送至 Discord。", "success");
    });
  });

  if (!sessionStorage.getItem(INITIAL_SYNC_KEY)) {
    sessionStorage.setItem(INITIAL_SYNC_KEY, "pending");
    void syncEmails(true);
  }

  document.addEventListener("astro:page-load", () => {
    syncThemeIcons();
  });
</script>

<style>
  .site-header {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: var(--space-3) 0;
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .brand-link:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .logo-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-logo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.3);
    object-fit: contain;
    transition: box-shadow var(--transition-base);
  }

  .brand-link:hover .brand-logo {
    box-shadow: 0 0 18px rgba(99, 102, 241, 0.6);
  }

  .status-pulse {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 8px;
    height: 8px;
    background-color: var(--color-success);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-success);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .brand-accent {
    color: var(--color-primary-hover);
    margin-left: 2px;
  }

  .brand-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-tertiary);
    font-weight: var(--font-weight-regular);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
    border-radius: var(--radius-full);
  }

  .search-icon {
    font-size: 16px;
    opacity: 0.8;
  }

  .header-search-wrap {
    display: flex;
    align-items: center;
  }

  .search-toggle-btn {
    padding: var(--space-2);
  }

  .header-search {
    width: 0;
    flex: 0 0 auto;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    margin-right: 0;
    transition:
      width var(--transition-base),
      margin-right var(--transition-base),
      opacity var(--transition-base),
      border-color var(--transition-base);
    background: var(--color-surface);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
  }

  .header-search-wrap--open .header-search {
    width: 260px;
    margin-right: var(--space-2);
    opacity: 1;
    pointer-events: auto;
    border-color: var(--color-border);
  }

  .header-search input {
    width: 100%;
    padding: var(--space-2) var(--space-4);
    border: none;
    background: transparent;
    color: var(--color-text);
    border-radius: var(--radius-full);
  }

  .header-search input:focus {
    outline: none;
  }

  .theme-toggle-btn {
    padding: var(--space-2);
  }

  .icon-only-btn {
    padding: var(--space-2);
  }

  .theme-icon {
    display: block;
  }

  /* 導航列動作的結果提示，掛在 header 下緣避免推動版面 */
  .header-toast {
    position: absolute;
    right: var(--space-6);
    bottom: calc(-1 * var(--space-2));
    transform: translateY(100%);
    max-width: min(420px, calc(100vw - var(--space-8)));
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md, 0 4px 16px rgba(0, 0, 0, 0.25));
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .header-toast[hidden] {
    display: none;
  }

  .header-toast[data-tone="success"] {
    color: var(--color-success);
    border-color: var(--color-success);
  }

  .header-toast[data-tone="error"] {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .connection-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-tertiary);
    color: var(--color-text-tertiary);
    /* 與同列 .nav-btn 使用相同字級、內距與邊框高度。 */
    padding: var(--space-2) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
  }
</style>
