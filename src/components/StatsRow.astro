---
import StatCard from "./StatCard.astro";
import CategoryCard from "./CategoryCard.astro";
import ImportantEmailCard from "./ImportantEmailCard.astro";
import type { DashboardStatTrends, EmailPreview, GmailUnreadStatus } from "../lib/emailQueries";

export interface Props {
  unreadCount: number;
  unreadStatus: GmailUnreadStatus;
  todayCount: number;
  /** pending 審核單涵蓋的郵件數（等使用者決定的），不含尚未送審的候選 */
  pendingReviewEmails: number;
  categoryCounts: { category: string; count: number }[];
  importantEmails: EmailPreview[];
  trends: DashboardStatTrends;
}

const { unreadCount, unreadStatus, todayCount, pendingReviewEmails, categoryCounts, importantEmails, trends } = Astro.props;
---

<div style="margin-bottom:var(--space-8);">
  <div class="stats-grid">
    <StatCard label="未讀討論串" value={unreadCount} href="/unread" accent="primary" trend={trends.unread} />
    <StatCard label="今日郵件" value={todayCount} accent="info" trend={trends.today} />
    {/* 趨勢資料來自 dashboard_stat_snapshots，尚未納入待審核，故不傳 trend */}
    <StatCard label="待審核" value={pendingReviewEmails} href="/reviews" accent="warning" />
    {categoryCounts.map(({ category, count }) => (
      <CategoryCard category={category} count={count} trend={trends.categories[category]} />
    ))}
  </div>
  {unreadStatus.source !== "gmail" && (
    <p class="sync-fallback" role="status">
      Gmail 暫時無法連線，未讀數使用{
        unreadStatus.source === "cache" && unreadStatus.updatedAt
          ? ` ${new Date(unreadStatus.updatedAt).toLocaleString("zh-TW", { timeZone: "Asia/Taipei" })} 的同步快取`
          : "資料庫對帳結果"
      }。
    </p>
  )}

  {importantEmails.length > 0 && (
    <div style="margin-top:var(--space-6);">
      <h2 style="font-size:var(--font-size-md); margin-bottom:var(--space-3);">⭐ 重要郵件</h2>
      <div id="important-email-row" class="important-row">
        {importantEmails.map((email) => (
          <ImportantEmailCard email={email} />
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .stats-grid {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-1);
    scrollbar-width: thin;
  }

  .stats-grid :global(.stat-card) {
    flex: 1 0 112px;
  }

  .important-row {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    padding-bottom: var(--space-2);
  }

  .sync-fallback {
    margin: var(--space-2) 0 0;
    color: var(--color-warning);
    font-size: var(--font-size-sm);
  }
</style>
