# =====================================================
# 環境變數範本 — Gmail 即時監控面板
# =====================================================
# 使用方式：
#   1. 複製此檔案為 .env：
#      cp .env.example .env
#   2. 填入實際的值（.env 已在 .gitignore 中，不會被提交）
# =====================================================

# ─── 部署目標切換開關 ───
# node   → 自托管（Oracle Cloud + Cloudflare Tunnel），adapter 用 @astrojs/node standalone
# 未設定 → Vercel（預設），adapter 用 @astrojs/vercel
# 切換後需重新 build；要切回 Vercel 只要把這行拿掉。詳見 scripts/deploy/README.md
# DEPLOY_TARGET=node

# ─── Supabase（僅伺服器端使用） ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── Pusher Channels ───
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=your_cluster

# 前端公開變數（不含 secret）
# 注意：PUBLIC_ 開頭的變數會在 **build 時** 被寫進前端 bundle，
# 因此 build 與執行兩個階段都必須提供。其餘變數則是 runtime 讀取（見 src/lib/env.ts）。
PUBLIC_PUSHER_KEY=your_key
PUBLIC_PUSHER_CLUSTER=your_cluster

# 自架 Pusher 相容服務（soketi）時才需要；未設定則連 Pusher 雲端
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_USE_TLS=false
# PUBLIC_PUSHER_HOST=ws.yourdomain.com
# PUBLIC_PUSHER_PORT=443
# PUBLIC_PUSHER_USE_TLS=true

# ─── Gmail OAuth2 ───
GMAIL_OAUTH_CLIENT_ID=your_client_id
GMAIL_OAUTH_CLIENT_SECRET=your_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=your_refresh_token
GMAIL_WATCH_ADDRESS=your_email@gmail.com

# ─── Google Cloud Pub/Sub ───
GCP_PROJECT_ID=your_project_id
PUBSUB_TOPIC=gmail-notifications
PUBSUB_AUDIENCE=https://mail.yourdomain.com/api/webhook/gmail
# 訂閱上 pushConfig.oidcToken.serviceAccountEmail 的值，用來驗證 push 請求來源：
#   gcloud pubsub subscriptions list --project=$GCP_PROJECT_ID \
#     --format="table(name, pushConfig.oidcToken.serviceAccountEmail, pushConfig.oidcToken.audience)"
PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-push@your_project_id.iam.gserviceaccount.com

# ─── 排程呼叫驗證（GitHub Actions workflow 帶此 Bearer token） ───
CRON_SECRET=your_random_secret_here

# ─── Discord Webhook（重要郵件與首次寄件者安全通知） ───
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx

# ─── Discord Bot（關鍵字清理審核訊息，Webhook 無法附帶按鈕故需 Bot） ───
# 1. Developer Portal 建立 Application + Bot，邀請進伺服器（需 Send Messages 權限）
# 2. Interactions Endpoint URL 設為 https://your-domain/api/discord/interactions
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CLEANUP_CHANNEL_ID=your_channel_id
DISCORD_PUBLIC_KEY=your_application_public_key

# ─── Google Gemini API（郵件摘要與重要性判斷） ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ─── Google Safe Browsing（首次寄件者的網域信譽查詢，選用） ───
# 未設定時仍可運作：安全狀態改以 Gmail 驗證標頭與本地白名單判定，
# 證據列會註明外部信譽訊號未採計。
# 於 GCP Console 啟用 Safe Browsing API 後建立 API 金鑰。
SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here

# ─── 自架站點收件匣（Cloudflare Email Worker → Webhook） ───
# Worker 端以 `npx wrangler secret put WEBHOOK_SECRET` 設定同一個值
INBOUND_EMAIL_WEBHOOK_SECRET=your_random_secret_here
# 自架收件網域（從收件人抽取別名用），未設定時預設 autodesignlab.org
INBOUND_EMAIL_DOMAIN=yourdomain.org

# ─── 網站網址（Discord 通知中的管理頁面連結） ───
SITE_URL=https://mail.yourdomain.com
