---
import SidebarLayout from "../../layouts/SidebarLayout.astro";
import EmailCard from "../../components/EmailCard.astro";
import { SENDER_GROUPS, findSenderGroup } from "../../lib/senderGroups";
import { listEmailsByGroup } from "../../lib/emailQueries";
import { extractSenderName } from "../../lib/senderUtils";

const { groupId } = Astro.params as { groupId: string };
const PAGE_SIZE = 50;

const group = findSenderGroup(groupId);

// groupId 不存在時 404
if (!group) {
  return Astro.redirect("/404");
}

const pageParam = Astro.url.searchParams.get("page");
const page = Math.max(1, Number(pageParam ?? "1") || 1);
const offset = (page - 1) * PAGE_SIZE;
const senderFilter = Astro.url.searchParams.get("sender")?.trim() ?? null;

const { emails: rawEmails, hasMore } = await listEmailsByGroup(SENDER_GROUPS, groupId, {
  limit: PAGE_SIZE,
  offset,
});

// 若有 sender 過濾，在記憶體中再過濾
const emails = senderFilter
  ? rawEmails.filter((e) => e.sender.toLowerCase().includes(senderFilter.toLowerCase()))
  : rawEmails;

// 依寄信者分組（與 unread.astro 相同）
interface SenderGroup {
  sender: string;
  emails: typeof emails;
}

const groups: SenderGroup[] = [];
const groupMap = new Map<string, typeof emails>();
for (const email of emails) {
  const existing = groupMap.get(email.sender);
  if (existing) {
    existing.push(email);
  } else {
    const arr = [email];
    groupMap.set(email.sender, arr);
    groups.push({ sender: email.sender, emails: arr });
  }
}

const pageTitle = `${group.label} — 未讀郵件`;

function buildPageHref(p: number): string {
  return p > 1 ? `/group/${groupId}?page=${p}` : `/group/${groupId}`;
}
---

<SidebarLayout title={`${pageTitle} — Gmail 即時監控面板`} activeView="unread">
  <!-- 頁面標題 + 麵包屑 -->
  <div class="group-breadcrumb">
    <a href="/" class="breadcrumb-link">首頁</a>
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current"><span class="material-symbols-rounded" aria-hidden="true">{group.icon}</span> {group.label}</span>
  </div>

  <h1 class="group-heading">
    <span class="material-symbols-rounded group-icon" aria-hidden="true" style={`color: var(${group.colorVar});`}>{group.icon}</span>
    {group.label}
    <span class="group-unread-hint">未讀郵件</span>
  </h1>

  {senderFilter && (
    <div class="sender-filter-bar">
      <span>篩選寄件者：</span>
      <span class="sender-filter-name">{senderFilter}</span>
      <a href={`/group/${groupId}`} class="sender-filter-clear">✕ 清除篩選</a>
    </div>
  )}

  <!-- 郵件折疊清單 -->
  <div id="email-list" data-unread-only="true" style="border:1px solid var(--color-border); border-radius:var(--radius-md); overflow:hidden;">
    {groups.map((g, i) => (
      <details class="sender-group" open={i === 0} data-sender={g.sender}>
        <summary class="sender-group-header">
          <span class="sender-group-toggle"></span>
          <input type="checkbox" class="group-select-all" aria-label={`全選 ${g.sender}`} />
          <span class="sender-group-name">{extractSenderName(g.sender)}</span>
          <span class="badge" style="background:var(--color-bg-tertiary); color:var(--color-text-secondary);">
            {g.emails.length} 封
          </span>
        </summary>
        <div class="sender-group-body">
          {g.emails.map((email) => (
            <EmailCard
              id={email.id}
              sender={email.sender}
              subject={email.subject}
              snippet={email.snippet}
              receivedAt={email.received_at}
              isRead={email.is_read}
              category={email.category}
              isImportant={email.is_important}
              isStarred={email.is_starred}
            />
          ))}
        </div>
      </details>
    ))}

    {emails.length === 0 && (
      <div style="text-align:center; padding:var(--space-16) 0; color:var(--color-text-tertiary);">
        <div style="font-size:3rem; margin-bottom:var(--space-4);">🎉</div>
        <p>此群組目前沒有未讀郵件</p>
      </div>
    )}
  </div>

  <!-- 分頁 -->
  <div style="display:flex; justify-content:space-between; margin-top:var(--space-8);">
    {page > 1 ? (
      <a href={buildPageHref(page - 1)} class="btn btn-outline">上一頁</a>
    ) : <span />}
    {hasMore && <a href={buildPageHref(page + 1)} class="btn btn-outline">下一頁</a>}
  </div>

  <style>
    /* 麵包屑 */
    .group-breadcrumb {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--font-size-xs);
      color: var(--color-text-tertiary);
      margin-bottom: var(--space-4);
    }
    .breadcrumb-link {
      color: var(--color-primary-hover);
      text-decoration: none;
    }
    .breadcrumb-link:hover { text-decoration: underline; }
    .breadcrumb-sep { color: var(--color-text-tertiary); }
    .breadcrumb-current { color: var(--color-text-secondary); }

    /* 標題 */
    .group-heading {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      font-size: var(--font-size-2xl);
      margin-bottom: var(--space-6);
    }
    .group-icon { font-size: 1.75rem; line-height: 1; }
    .group-unread-hint {
      font-size: var(--font-size-base);
      font-weight: var(--font-weight-regular);
      color: var(--color-text-secondary);
    }

    /* 折疊清單（與 unread.astro 相同） */
    .sender-group { border-bottom: 1px solid var(--color-border-subtle); }
    .sender-group:last-child { border-bottom: none; }
    .sender-group-header {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      background: var(--color-bg-secondary);
      cursor: pointer;
      user-select: none;
      list-style: none;
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }
    .sender-group-header::-webkit-details-marker { display: none; }
    .sender-group-header::marker { content: ""; }
    .sender-group-toggle {
      width: 0; height: 0;
      border-left: 4px solid var(--color-text-tertiary);
      border-top: 4px solid transparent;
      border-bottom: 4px solid transparent;
      transition: transform var(--transition-fast);
      flex-shrink: 0;
    }
    .sender-group[open] > .sender-group-header .sender-group-toggle {
      transform: rotate(90deg);
    }
    .sender-group-name {
      font-weight: var(--font-weight-medium);
      color: var(--color-text);
    }
    .group-select-all {
      flex-shrink: 0;
      accent-color: var(--color-primary);
    }

    /* 寄件者篩選提示列 */
    .sender-filter-bar {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-3);
      background: var(--color-primary-muted);
      border: 1px solid var(--color-primary);
      border-radius: var(--radius-md);
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
      margin-bottom: var(--space-4);
    }
    .sender-filter-name {
      font-weight: var(--font-weight-semibold);
      color: var(--color-primary-hover);
    }
    .sender-filter-clear {
      margin-left: auto;
      font-size: var(--font-size-xs);
      color: var(--color-text-tertiary);
      text-decoration: none;
      padding: 2px var(--space-2);
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-border);
      transition: color var(--transition-fast), border-color var(--transition-fast);
    }
    .sender-filter-clear:hover {
      color: var(--color-error);
      border-color: var(--color-error);
    }
  </style>


  <script>
    import { initEmailList } from "../../lib/emailListClient";
    initEmailList(document.getElementById("email-list")!);
  </script>
</SidebarLayout>
